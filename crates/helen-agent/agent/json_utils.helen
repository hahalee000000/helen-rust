// ═══════════════════════════════════════════════════════════════════
// Helen Programming Agent - JSON 工具函数
// ═══════════════════════════════════════════════════════════════════
//
// 跨模块复用的 JSON 解析工具，统一 agent 响应的防御性解析逻辑。
//

/** 安全解析 agent 返回的 JSON 字符串。
 *  降级链：直接解析 → 从 ```json 代码块提取 → 返回 default_val（raw 放入 fallback_field）
 *
 *  参数:
 *    raw: 待解析的字符串（可能是纯 JSON、markdown 包裹 JSON、或纯文本）
 *    default_val: 解析全部失败时的回退 map（会被注入 raw 内容）
 *    fallback_field: 回退 map 中存放 raw 文本的字段名
 *
 *  返回: 解析后的 map */
import std.core.*
import std.data.*
import std.str.*
fn safe_parse_agent_json(raw: str, default_val: map, fallback_field: str): map {
    if raw == "" {
        return default_val
    }

    // 尝试 1：直接解析
    try {
        return json_parse(raw)
    } catch { }

    // 尝试 2：从 ```json ... ``` 代码块提取
    let parts = split(raw, "```json")
    if len(parts) >= 2 {
        let inner = split(parts[1], "```")
        try {
            return json_parse(inner[0])
        } catch { }
    }

    // 全部失败：用 default_val + raw 内容
    let result = default_val
    result[fallback_field] = raw
    return result
}
