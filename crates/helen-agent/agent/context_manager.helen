// ═══════════════════════════════════════════════════════════════════
// Helen Programming Agent - 上下文管理器 (v1.19-v1.20)
// ═══════════════════════════════════════════════════════════════════
//
// 统一上下文管理 SSOT：
// - 自动压缩：75% 常规 / 90% 紧急
// - 版本检测：从 ~/helen/wiki/appendix/changelog.md 动态读取
// - 事实刷新：每 10 轮刷新 git/date 到 working_memory
// - 会话作用域：自动配置 .helen/sessions/
// - Pin 管理：钉住重要消息免疫压缩
//
// 所有 v1.19 API 均用 try-catch 包裹，旧版 Helen 静默降级。
//

import std.context.*
import std.core.*
import std.debug.*
import std.io.*
import std.path.*
import std.str.*
import std.time.*
import std.tools.*
import std.transcript.*
import "output.helen"
import "session_stats.helen"
import "utils.helen"

// ── 常量 ──────────────────────────────────────────────────────────
const AUTO_COMPRESS_THRESHOLD = 0.75   // 75% 触发常规压缩
const URGENT_COMPRESS_THRESHOLD = 0.90 // 90% 触发紧急压缩
const FACT_REFRESH_INTERVAL = 10       // 每 10 轮刷新环境事实
const VERSION_CHECK_INTERVAL = 50      // 每 50 轮复检版本
// 注：Helen 版本检测函数已移至 utils.helen 的 detect_helen_version()（共享给 context.helen）。

// ── ContextManager shared store ──────────────────────────────────
shared store ContextManager {
    let initialized: bool = false
    let last_compress_turn: int = 0
    let last_fact_refresh: int = 0
    let last_version_check: int = 0
    let cached_version: str = ""
    let pinned_uuids: list = []        // 钉住的消息 UUID 列表
    let session_dir_path: str = ""     // 当前会话目录

    /** 初始化上下文管理器（幂等，多次调用安全）
     *  v1.29.15: 接受可选 cwd 参数，供 actor 传入已知的工作目录，
     *  避免 shell_exec("pwd") 在子线程/actor 上下文中返回错误路径。
     *  (v1.29.15 修复了 shared store 默认参数支持) */
    fn init(cwd: str = "") {
        // v1.29.15: 关键修复 —— shared store 在 spawn 时可能被共享，
        // `initialized` 标志可能已被另一个 interpreter 设为 true，
        // 但 session_dir_path 可能为空（另一个 interpreter 的 _setup_session_scope 失败）。
        // 当 session_dir_path 为空时，强制重新设置。
        if initialized && session_dir_path != "" { return }
        initialized = true
        cached_version = detect_helen_version()
        session_dir_path = _setup_session_scope(cwd)
        _register_hooks()
        _rebuild_pinned_uuids()
    }

    // ── 自动压缩 ────────────────────────────────────────────────

    /** 检查上下文占用率，必要时自动压缩。
     *  返回: {"status": "ok"|"auto_compress"|"urgent_compress"|"not_initialized", ...} */
    fn check_and_compress(turn: int): map {
        if !initialized { return {"status": "not_initialized"} }

        // 防止同一轮重复压缩
        if turn == last_compress_turn {
            return {"status": "ok", "usage": 0.0, "action": "skipped_same_turn"}
        }

        let usage = _safe_context_usage()
        let result = {"status": "ok", "usage": usage, "action": "none"}

        if usage >= URGENT_COMPRESS_THRESHOLD {
            // 紧急压缩：使用 truncate 保留最近消息
            let r = _safe_compress("truncate")
            last_compress_turn = turn
            result = {"status": "urgent_compress", "usage": usage, "result": r}
            warning("⚠️  上下文占用 " + str(int(usage * 100)) + "%，已紧急压缩（truncate）")
        } else if usage >= AUTO_COMPRESS_THRESHOLD {
            // 常规压缩：使用 auto（graduated pipeline）
            let r = _safe_compress("auto")
            last_compress_turn = turn
            result = {"status": "auto_compress", "usage": usage, "result": r}
            info("上下文占用 " + str(int(usage * 100)) + "%，已自动压缩")
        }

        return result
    }

    // ── 事实刷新 ────────────────────────────────────────────────

    /** 每 FACT_REFRESH_INTERVAL 轮刷新关键事实到 working_memory */
    fn refresh_facts_if_needed(turn: int) {
        if !initialized { return }
        if turn - last_fact_refresh < FACT_REFRESH_INTERVAL { return }

        try {
            working_memory_set("git_branch", safe_git_branch())
            working_memory_set("git_dirty", check_git_dirty())
            working_memory_set("current_date", date())  // "YYYY-MM-DD"
            // 当前时间：从 now() 提取 HH:MM:SS
            let now_str = now()  // "YYYY-MM-DDTHH:MM:SS"
            let time_str = substring(now_str, 11, 19)  // "HH:MM:SS"
            working_memory_set("current_time", time_str)
            last_fact_refresh = turn
        } catch RuntimeError err {
            warning("working_memory 写入失败: " + err.message)
        } catch {
            // working_memory 不可用时静默降级（旧版 Helen）
        }
    }

    // ── 版本管理 ────────────────────────────────────────────────

    /** 获取当前 Helen 版本（缓存） */
    fn get_version(): str {
        if cached_version == "" {
            cached_version = detect_helen_version()
        }
        return cached_version
    }

    /** 每 VERSION_CHECK_INTERVAL 轮复检版本 */
    fn check_version_if_needed(turn: int) {
        if turn - last_version_check >= VERSION_CHECK_INTERVAL {
            cached_version = detect_helen_version()
            last_version_check = turn
        }
    }

    // ── Pin 管理 ────────────────────────────────────────────────

    /** 钉住消息（免疫所有 5 层压缩） */
    fn pin(uuid: str): bool {
        try {
            pin_message(uuid)
            pinned_uuids = pinned_uuids + [uuid]
            return true
        } catch RuntimeError err {
            warning("pin_message 失败: " + err.message)
            return false
        } catch {
            // pin_message API 不可用（旧版 Helen）
            return false
        }
    }

    /** 取消钉住 */
    fn unpin(uuid: str): bool {
        try {
            unpin_message(uuid)
            let new_list = []
            for u in pinned_uuids {
                if u != uuid { new_list = new_list + [u] }
            }
            pinned_uuids = new_list
            return true
        } catch RuntimeError err {
            warning("unpin_message 失败: " + err.message)
            return false
        } catch {
            return false
        }
    }

    /** 获取已钉住消息列表 */
    fn get_pinned(): list {
        return pinned_uuids
    }

    /** 设置钉住消息列表（供模块级 _rebuild_pinned_uuids 调用） */
    fn set_pinned_uuids(list: list) {
        pinned_uuids = list
    }

    // ── 会话统计 ────────────────────────────────────────────────

    /** 获取上下文统计
     *  v1.23 适配：优先读 SessionStats 的 last_* 快照（ChatSession.main 退出前记录，
     *  反映本轮准确的消息数），避免 context_stats() 走 store.read_view() 返回
     *  跨 invocation 累积的虚高数字。无快照时 fallback 到 context_stats()。 */
    fn get_stats(): map {
        // 优先读 SessionStats 快照（ChatSession.main 每轮结束前记录）
        try {
            let snap = SessionStats.get_stats()
            if snap["last_has_snapshot"] {
                return {
                    "status": "ok",
                    "message_count": snap["last_message_count"],
                    "total_tokens": snap["last_total_tokens"],
                    "usage_ratio": snap["last_usage_ratio"],
                    "pinned_count": len(pinned_uuids),
                    "working_memory": _safe_working_memory_snapshot()
                }
            }
        } catch {
            // SessionStats 不可用或字段缺失，fallback
        }

        // Fallback: 直接读 context_stats()（首次调用或快照不可用时）
        try {
            let stats = context_stats()
            return {
                "status": "ok",
                "message_count": stats["message_count"],
                "total_tokens": stats["total_tokens"],
                "usage_ratio": stats["usage_ratio"],
                "pinned_count": len(pinned_uuids),
                "working_memory": _safe_working_memory_snapshot()
            }
        } catch RuntimeError err {
            warning("context_stats() 失败: " + err.message)
            return {"status": "unavailable", "error": err.message}
        } catch {
            return {"status": "unavailable", "error": "context_stats() not supported"}
        }
    }

    /** 获取当前占用率（0.0–1.0+） */
    fn get_usage(): float {
        return _safe_context_usage()
    }

    /** 获取会话目录路径 */
    fn get_session_dir(): str {
        return session_dir_path
    }

    // ── 重置（/clear 时调用）────────────────────────────────────

    /** 重置所有状态（保留 initialized 和 cached_version） */
    fn reset() {
        last_compress_turn = 0
        last_fact_refresh = 0
        pinned_uuids = []
        try { working_memory_clear() } catch {
            // working_memory 不可用时静默降级
        }
    }
}

// ── 内部辅助函数 ─────────────────────────────────────────────────
//
// 注：detect_helen_version() / safe_git_branch() / check_git_dirty() 已移至
// utils.helen（共享给 context.helen，避免双份实现）。本模块通过
// import "utils.helen" 直接使用。

/** 配置会话作用域：优先项目 .helen/sessions/，否则全局
 *  v1.29.15: 接受可选 cwd 参数，避免 shell_exec("pwd") 在 actor/子线程上下文
 *  中返回不正确的路径。当 cwd 提供时直接使用，否则回退到 get_cwd()。*/
fn _setup_session_scope(cwd_hint: str): str {
    let project_helen = ""
    if cwd_hint != "" {
        project_helen = path_join(cwd_hint, ".helen")
    } else {
        try {
            let cwd = get_cwd()
            project_helen = path_join(cwd, ".helen")
        } catch {
            project_helen = ".helen"
        }
    }
    if !path_exists(project_helen) {
        return ""
    }

    // Step 2: 确保会话目录存在
    let session_dir = path_join(project_helen, "sessions")
    try {
        if !path_exists(session_dir) {
            mkdir_p(session_dir)
        }
    } catch RuntimeError err {
        warning("会话作用域: 创建目录失败: " + err.message)
        return ""
    } catch {
        warning("会话作用域: 创建目录失败(unknown)")
        return ""
    }

    // Step 3: 调用 v1.20 API 设置会话目录（已确保是绝对路径）
    try {
        set_session_dir(session_dir)
        return session_dir
    } catch RuntimeError err {
        warning("会话作用域: set_session_dir 失败: " + err.message)
        return ""
    } catch {
        warning("会话作用域: set_session_dir 失败(unknown)")
        return ""
    }
}

/** 注册压缩事件回调 */
fn _register_hooks() {
    try {
        on_compression(fn(data) {
            // 轻量日志，避免干扰用户
        })
    } catch {
        // on_compression 不可用时静默降级
    }
}

/** 从 transcript 重建 pinned_uuids（启动时调用，恢复持久化的 pin 状态）
 *  解决 pin 状态"压缩保护跨重启有效，但 /pin 显示列表重启后清空"的不一致。
 *  必须作为模块级函数（shared store 方法间互调受限），通过 ContextManager.pinned_uuids 写入。 */
fn _rebuild_pinned_uuids() {
    try {
        let pinned = list_pinned_messages()
        if pinned != null && len(pinned) > 0 {
            let new_list = []
            for m in pinned {
                let uuid = m["uuid"]
                if uuid != "" && uuid != null {
                    new_list = new_list + [uuid]
                }
            }
            ContextManager.set_pinned_uuids(new_list)
            debug("_rebuild_pinned_uuids: restored " + str(len(new_list)) + " pinned messages")
        } else {
            debug("_rebuild_pinned_uuids: no pinned messages found in transcript")
        }
    } catch RuntimeError err {
        warning("_rebuild_pinned_uuids failed: " + err.message)
    } catch {
        // list_pinned_messages 不可用（旧版 Helen）或 transcript 为空，静默忽略
        warning("_rebuild_pinned_uuids failed (unknown error)")
    }
}

/** 安全获取上下文占用率 */
fn _safe_context_usage(): float {
    try {
        return context_usage()
    } catch {
        return 0.0
    }
}

/** 安全调用 compress_context */
fn _safe_compress(strategy: str): map {
    try {
        return compress_context(strategy)
    } catch {
        return {"status": "error", "error": "compress_context failed"}
    }
}

/** 安全获取 working_memory 快照
 *  返回工作记忆的 data 字段（map），失败返回空 map。
 *  working_memory_get() 返回 {"status": "ok", "data": {...}}，
 *  本函数提取 data 字段供 /stats 等命令直接使用。 */
fn _safe_working_memory_snapshot(): map {
    try {
        let result = working_memory_get()
        if result["status"] == "ok" {
            return result["data"]
        }
        return {}
    } catch {
        return {}
    }
}
