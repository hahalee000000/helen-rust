// ═══════════════════════════════════════════════════════════════════
// Helen Programming Agent - 会话统计 (v1.23)
// ═══════════════════════════════════════════════════════════════════
//
// v1.23 适配：Per-Main Fresh Context 下 context_stats() 走 store.read_view()
// 返回全部消息（跨 invocation 累积，含重复导入的历史）。为让 /stats 显示
// 当前 ChatSession 本轮的准确消息数，ChatSession.main 在退出前把 context_stats
// 快照写入 last_* 字段，/stats 优先读这些字段（fallback 到 context_stats）。
//
// 独立模块（被 chat_session_actor.helen / context_manager.helen / commands.helen 共用），
// 避免循环依赖。

// ── 会话统计 ──────────────────────────────────────────────────────
import std.core.*
import std.time.*
shared store SessionStats {
    let start_time: int = 0
    let conversation_turns: int = 0
    let agent_calls: int = 0
    let total_tokens_estimated: int = 0

    // 本轮 ChatSession 的准确消息数（main 退出前快照）
    let last_message_count: int = 0
    let last_total_tokens: int = 0
    let last_usage_ratio: float = 0.0
    let last_has_snapshot: bool = false

    fn init() {
        // v1.23：只在首次调用时初始化（让 conversation_turns / agent_calls /
        // total_tokens_estimated 跨轮次累计，而不是每轮重置）。
        // start_time 为 0 表示首次调用。
        if start_time == 0 {
            start_time = int(time())  // 跨平台：用 stdlib time()
        }
        // 注意：conversation_turns / agent_calls / total_tokens_estimated 保留上轮值
        // 注意：last_* 也不重置，保留上一轮快照供 /stats 读
    }

    fn increment_turns() {
        conversation_turns = conversation_turns + 1
    }

    fn increment_agent_calls() {
        agent_calls = agent_calls + 1
    }

    fn add_tokens(n: int) {
        total_tokens_estimated = total_tokens_estimated + n
    }

    fn get_elapsed_time(): int {
        if start_time == 0 { return 0 }
        let ts_now = int(time())  // 跨平台：用 stdlib time()
        return ts_now - start_time
    }

    /** 记录本轮 ChatSession 的消息统计快照（main 退出前调用） */
    fn record_snapshot(message_count: int, total_tokens: int, usage_ratio: float) {
        last_message_count = message_count
        last_total_tokens = total_tokens
        last_usage_ratio = usage_ratio
        last_has_snapshot = true
    }

    fn get_stats(): map {
        return {
            "start_time": start_time,
            "conversation_turns": conversation_turns,
            "agent_calls": agent_calls,
            "total_tokens_estimated": total_tokens_estimated,
            "elapsed_time": SessionStats.get_elapsed_time(),
            "last_message_count": last_message_count,
            "last_total_tokens": last_total_tokens,
            "last_usage_ratio": last_usage_ratio,
            "last_has_snapshot": last_has_snapshot
        }
    }
}
