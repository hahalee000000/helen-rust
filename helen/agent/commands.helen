// ═══════════════════════════════════════════════════════════════════
// Helen Programming Agent - 斜杠命令系统
// ═══════════════════════════════════════════════════════════════════
//
// 实现 Claude Code 风格的斜杠命令
//
// 支持的命令：
// - /help              显示帮助信息
// - /dir [path]        查看/切换工作目录（WebUI）
// - /clear             清空对话上下文（保留会话实体，插入 BoundaryMarker）
// - /clear-session [<sid>]  删除整个会话（级联删除 spawn transcripts）
// - /compress          压缩上下文
// - /stats             显示会话统计
// - /memory            显示记忆系统状态
// - /working-memory    显示工作记忆内容
// - /goal <text>       自主 Pursue 目标（自动续传直到完成）
//
// 使用示例：
//   let cmd = parse_command("/help")
//   if cmd["is_command"] {
//       execute_command(cmd)
//   }
//

import std.context.*
import std.core.*
import std.dict.*
import std.file.*
import std.list.*
import std.path.*
import std.str.*
import std.time.*
import std.transcript.*
import "lang.helen"
import "output.helen"
import "context_manager.helen"
import "system_reminders.helen"

// ── 命令解析 ──────────────────────────────────────────────────────

/** 解析斜杠命令
 *  返回: {"is_command": bool, "command": str, "args": list<str>} */
fn parse_command(text: str): map {
    // 预处理：去除前后空白 + 全角斜杠归一化
    let trimmed = strip(text)
    trimmed = replace(trimmed, "／", "/")

    // 检查是否以 / 开头
    if !startswith(trimmed, "/") {
        return {"is_command": false, "command": "", "args": []}
    }

    // 移除 / 前缀
    let without_slash = trim_prefix(trimmed, "/")

    // 分割命令和参数
    let parts = split(without_slash, " ")
    if len(parts) == 0 {
        return {"is_command": false, "command": "", "args": []}
    }

    let command = parts[0]
    let args = []
    let i = 1
    while i < len(parts) {
        if parts[i] != "" {
            args = args + [parts[i]]
        }
        i = i + 1
    }

    return {
        "is_command": true,
        "command": command,
        "args": args
    }
}

// ── 命令执行 ──────────────────────────────────────────────────────

/** 执行斜杠命令
 *  返回: 命令响应文本（可能为空），空字符串 + 非 is_command 表示未识别
 *
 *  注：v5.2 之前每个命令都有 _cmd_X()（CLI 直接打印）+ _cmd_X_response()（返回字符串）
 *  两个版本。v5.2 合并为单一 _cmd_X() 返回字符串。 */
fn execute_command(cmd: map): str {
    if !cmd["is_command"] {
        return ""
    }

    try { init_lang() } catch {}

    let command = cmd["command"]
    let args = cmd["args"]

    match command {
        case "help" {
            return _cmd_help()
        }
        case "dir" {
            return _cmd_dir(args)
        }
        case "clear" {
            return _cmd_clear()
        }
        case "clear-session" {
            return _cmd_clear_session(args)
        }
        case "compress" {
            return _cmd_compress()
        }
        case "stats" {
            return _cmd_stats()
        }
        case "memory" {
            return _cmd_memory()
        }
        case "context" {
            return _cmd_context()
        }
        case "version" {
            return _cmd_version()
        }
        case "session" {
            return _cmd_session(args)
        }
        case "pin" {
            return _cmd_pin(args)
        }
        case "unpin" {
            return _cmd_unpin(args)
        }
        case "search" {
            return _cmd_search(args)
        }
        case "mode" {
            return _cmd_mode(args)
        }
        case "working-memory" {
            return _cmd_working_memory(args)
        }
        case "goal" {
            return _cmd_goal(args)
        }
        default {
            return build_unknown_command_text(command)
        }
    }
}

/** 检查是否为退出命令 */
// ── 命令实现 ──────────────────────────────────────────────────────
//
// 注：v5.2 之前每个命令有 _cmd_X()（CLI 直接打印）+ _cmd_X_response()（返回字符串）
// 两个版本。v5.2 合并为单一 _cmd_X() 返回字符串。

/** 构建帮助文本 */
fn build_help_text(): str {
    let text = _t("## Available Commands\n\n", "## 可用命令\n\n")
    text = text + _t("| Command | Description |\n", "| 命令 | 说明 |\n")
    text = text + "|------|------|\n"
    text = text + _t("| `/help` | Show this help message |\n", "| `/help` | 显示本帮助信息 |\n")
    text = text + _t("| `/dir [path]` | View or switch working directory (WebUI only) |\n", "| `/dir [path]` | 查看或切换工作目录（仅 WebUI） |\n")
    text = text + _t("| `/clear` | Clear conversation history and reset all state (keeps session entity, inserts BoundaryMarker) |\n", "| `/clear` | 清空对话历史并重置所有状态（保留会话实体，插入 BoundaryMarker） |\n")
    text = text + _t("| `/clear-session [<sid>]` | Delete entire session (cascade delete spawn transcripts); no arg deletes current session |\n", "| `/clear-session [<sid>]` | 删除整个会话（级联删除 spawn transcripts）；无参数则删当前会话 |\n")
    text = text + _t("| `/compress` | LLM semantic context compression (preserves semantics, frees token space) |\n", "| `/compress` | LLM 语义压缩上下文（保留语义，释放 token 空间） |\n")
    text = text + _t("| `/context` | View context details (usage ratio, tokens, version, session dir, working memory) |\n", "| `/context` | 查看上下文详情（占用率、token、版本、会话目录、工作记忆） |\n")
    text = text + _t("| `/stats` | View session statistics (message count, tokens, conversation turns) |\n", "| `/stats` | 查看会话统计（消息数、token、对话轮次） |\n")
    text = text + _t("| `/memory` | View memory system status (Agent memory + user preferences) |\n", "| `/memory` | 查看记忆系统状态（Agent 记忆 + 用户偏好） |\n")
    text = text + _t("| `/version` | View Helen language version |\n", "| `/version` | 查看 Helen 语言版本 |\n")
    text = text + _t("| `/session` | View current session info (ID, directory, transcript file count) |\n", "| `/session` | 查看当前会话信息（ID、目录、transcript 文件数） |\n")
    text = text + _t("| `/session list` | List all sessions (creation time, status, message count) |\n", "| `/session list` | 列出所有会话（创建时间、状态、消息数） |\n")
    text = text + _t("| `/session delete <sid>` | Delete specified session (cascades to spawned) |\n", "| `/session delete <sid>` | 删除指定会话（级联删除 spawn 树） |\n")
    text = text + _t("| `/session view <sid>` | View user messages in specified session |\n", "| `/session view <sid>` | 查看指定会话的用户消息 |\n")
    text = text + _t("| `/pin <uuid>` | Pin a message so it is preserved under all compression strategies |\n", "| `/pin <uuid>` | 钉住指定消息，使其在所有压缩策略下均被保留 |\n")
    text = text + _t("| `/unpin <uuid>` | Unpin a message |\n", "| `/unpin <uuid>` | 取消钉住指定消息 |\n")
    text = text + _t("| `/search <query>` | Full-text search messages in current context |\n", "| `/search <query>` | 在当前上下文中全文搜索消息 |\n")
    text = text + _t("| `/mode [name]` | View or switch output mode (minimal / normal / verbose / rich) |\n", "| `/mode [name]` | 查看或切换输出模式（minimal / normal / verbose / rich） |\n")
    text = text + _t("| `/working-memory` | View working memory content (`get <key>` / `stats`) |\n", "| `/working-memory` | 查看工作记忆内容（`get <key>` / `stats`） |\n")
    text = text + _t("| `/goal <text>` | Autonomously pursue a goal (auto-continue until complete) |\n", "| `/goal <text>` | 自主 Pursue 目标（自动续传直到完成） |\n")
    text = text + _t("\n> Tip: Type text directly to chat with AI, or use the slash commands above\n", "\n> 提示：直接输入文本与 AI 对话，或使用上述斜杠命令执行操作\n")
    return text
}

/** 构建未知命令的提示文本 */
fn build_unknown_command_text(command: str): str {
    return _t("❌ Unknown command: /" + command + "\n\nType /help for available commands", "❌ 未知命令: /" + command + "\n\n输入 /help 查看可用命令")
}

/** /help - 显示帮助信息 */
fn _cmd_help(): str {
    return build_help_text()
}

/** /dir [path] — 查看/切换工作目录
 *  WebUI 中由后端拦截并处理。
 *  CLI/REPL 中此命令不可用。 */
fn _cmd_dir(args: list): str {
    if len(args) == 0 {
        return _t(
            "Usage: /dir [path]\nExample: /dir ~/projects/myapp\n\nNote: This command is only available in the WebUI. In CLI/REPL, use the `cd` command or start Helen from the desired directory.",
            "用法: /dir [path]\n示例: /dir ~/projects/myapp\n\n注意: 此命令仅在 WebUI 中可用。在 CLI/REPL 中，请使用 `cd` 命令或从目标目录启动 Helen。"
        )
    }
    // WebUI 中此命令不会到达这里（被 chat.py 拦截）
    // CLI/REPL 中返回提示
    return _t(
        "⚠️ The /dir command is only available in the WebUI.\n\nIn CLI/REPL, please use the `cd` command or start Helen from the desired directory.",
        "⚠️ /dir 命令仅在 WebUI 中可用。\n\n在 CLI/REPL 中，请使用 `cd` 命令或从目标目录启动 Helen。"
    )
}

/** /clear - 清空对话上下文并重置所有状态
 *  __HELEN_CLEAR_OK__ 是静默标记，Python 后端会解析并发送 clear_messages 事件到前端
 *  让 Web UI 同步清空显示的消息和 localStorage 中的会话 ID */
fn _cmd_clear(): str {
    clear_context()
    ContextManager.reset()
    reset_turn_counter()
    return _t("✅ Conversation history cleared, state reset.\n", "✅ 对话历史已清空，状态已重置。\n") + "__HELEN_CLEAR_OK__"
}

/** /clear-session [<sid>] - 删除整个会话（级联删除 spawn transcripts）
 *  无参数时删除当前会话；带 <sid> 参数时删除指定会话。
 *  复用斜杠命令路径（不走特殊内部协议），与 /clear 语义区分：
 *    - /clear          = 清空对话历史（保留会话实体，transcript 仍在，插入 BoundaryMarker）
 *    - /clear-session  = 删除整个会话（级联删除 spawn transcripts，transcript 文件被移除）
 *
 *  __HELEN_CLEAR_SESSION_OK__ 是静默标记，Python 后端（chat.py DELETE 端点）
 *  解析后同步删除 Web UI SQLite 中该会话的消息和会话实体。
 *
 *  设计背景：见 reports/context-and-transcript-architecture.md §反馈 2（v2.1 定稿）。
 *  依赖 Helen v1.23.7+ 的 delete_session(cascade=true) / delete_current_session(cascade=true)。 */
fn _cmd_clear_session(args: list): str {
    let target = ""
    if len(args) > 0 {
        target = args[0]
    }

    let cur = ""
    try {
        cur = get_session_id()
    } catch {
        cur = ""
    }

    // 列出将要被级联删除的 spawn sessions（用于响应文本，供用户审计）
    let parent_for_display = target
    if parent_for_display == "" || parent_for_display == cur {
        parent_for_display = cur
    }
    let children_count = 0
    if parent_for_display != "" {
        try {
            let children = get_spawned_sessions(parent_for_display)
            if children != null && len(children) > 0 {
                children_count = len(children)
            }
        } catch {
            // get_spawned_sessions 不可用，静默忽略
        }
    }

    let header = _t("## Session Deletion\n\n", "## 会话删除\n\n")
    try {
        if target == "" || target == cur {
            // 删除当前会话：级联删除其 spawn 树
            let result = delete_current_session(confirm=true, cascade=true)
            // 检查返回值：delete_current_session 失败时返回 {status: "error"} 而非抛异常
            if result == null || result["status"] != "ok" {
                let err_msg = _t("Unknown error", "未知错误")
                try { err_msg = result["message"] } catch {}
                return header + _t("- Action: ❌ Deletion failed\n", "- 操作: ❌ 删除失败\n") + _t("- Session ID: ", "- 会话 ID: ") + cur + "\n" + _t("- Error: ", "- 错误: ") + err_msg + "\n"
            }
            // 清除 current_session_id 文件，强制下次调用创建新 session
            try {
                if path_exists(".helen/current_session_id") {
                    delete_file(".helen/current_session_id")  // 跨平台：用 stdlib
                }
            } catch {
                // 清除文件失败不影响主流程
            }
            let text = header
            text = text + _t("- Action: ✅ Current session deleted\n", "- 操作: ✅ 已删除当前会话\n")
            if cur != "" {
                text = text + _t("- Session ID: ", "- 会话 ID: ") + cur + "\n"
            }
            if children_count > 0 {
                text = text + _t("- Cascade deleted: ", "- 级联删除: ") + str(children_count) + _t(" spawn sessions\n", " 个 spawn session\n")
            }
            return text + "\n__HELEN_CLEAR_SESSION_OK__"
        } else {
            let result = delete_session(target, cascade=true)
            if result == null || result["status"] != "ok" {
                let err_msg = _t("Unknown error", "未知错误")
                try { err_msg = result["message"] } catch {}
                return header + _t("- Action: ❌ Deletion failed\n", "- 操作: ❌ 删除失败\n") + _t("- Session ID: ", "- 会话 ID: ") + target + "\n" + _t("- Error: ", "- 错误: ") + err_msg + "\n"
            }
            let text = header
            text = text + _t("- Action: ✅ Specified session deleted\n", "- 操作: ✅ 已删除指定会话\n")
            text = text + _t("- Session ID: ", "- 会话 ID: ") + target + "\n"
            if children_count > 0 {
                text = text + _t("- Cascade deleted: ", "- 级联删除: ") + str(children_count) + _t(" spawn sessions\n", " 个 spawn session\n")
            }
            return text + "\n__HELEN_CLEAR_SESSION_OK__"
        }
    } catch RuntimeError err {
        return header + _t("- Action: ❌ Deletion failed\n- Error: ", "- 操作: ❌ 删除失败\n- 错误: ") + err.message + "\n"
    } catch {
        return header + _t("- Action: ❌ Deletion failed\n- Reason: requires Helen v1.23.7+ cascade delete support\n", "- 操作: ❌ 删除失败\n- 原因: 需要 Helen v1.23.7+ 的 cascade 删除支持\n")
    }
}

/** /compress - 压缩上下文（LLM 语义摘要，保留上下文）
 *  使用 compress_context("summarize") 强制 LLM 生成语义摘要。
 *  曾被 hahalee000000/helen#13 阻塞（TranscriptStore 路径忽略 strategy），已在上游修复。
 *  WORKAROUND: hahalee000000/helen#23 — compressed_tokens 返回值错误，改用 context_stats() */
fn _cmd_compress(): str {
    let before_stats = context_stats()
    let original_tokens = before_stats["total_tokens"]

    let result = compress_context("summarize")

    // WORKAROUND for helen#23: compress_context 返回的 compressed_tokens 错误
    // 改用 context_stats() 获取压缩后的实际 tokens
    let after_stats = context_stats()
    let compressed_tokens = after_stats["total_tokens"]

    if original_tokens != null && compressed_tokens != null {
        return _t("✅ Context compressed: ", "✅ 上下文已压缩: ") + str(original_tokens) + " → " + str(compressed_tokens) + " tokens"
    }
    return _t("✅ Context compression complete.", "✅ 上下文压缩完成。")
}

/** /stats - 显示会话统计 */
fn _cmd_stats(): str {
    let text = _t("## Session Statistics\n\n", "## 会话统计\n\n")
    let stats = ContextManager.get_stats()
    if stats["status"] == "ok" {
        text = text + _t("- Messages: ", "- 消息数: ") + str(stats["message_count"]) + "\n"
        text = text + _t("- Total tokens: ", "- 总 tokens: ") + str(stats["total_tokens"]) + "\n"
        let usage_pct = int(stats["usage_ratio"] * 100)
        text = text + _t("- Context usage: ", "- 上下文占用: ") + str(usage_pct) + "%\n"
    } else {
        text = text + _t("Context statistics unavailable (", "上下文统计不可用（") + str(stats["error"]) + _t(")\n", "）\n")
    }
    text = text + _t("- Conversation turns: ", "- 对话轮次: ") + str(get_turn_counter()) + "\n"
    text = text + _t("- Helen version: v", "- Helen 版本: v") + ContextManager.get_version() + "\n"
    return text
}

/** /memory - 显示记忆系统状态 */
fn _cmd_memory(): str {
    let text = _t("## Memory System Status\n\n", "## 记忆系统状态\n\n")
    if path_exists(".helen/MEMORY.md") {
        let mc = read_file(".helen/MEMORY.md")
        text = text + _t("- Agent memory: ", "- Agent 记忆: ") + str(len(mc)) + _t(" chars\n", " 字符\n")
    } else {
        text = text + _t("- Agent memory: (empty)\n", "- Agent 记忆: （空）\n")
    }
    if path_exists(".helen/USER.md") {
        let up = read_file(".helen/USER.md")
        text = text + _t("- User preferences: ", "- 用户偏好: ") + str(len(up)) + _t(" chars\n", " 字符\n")
    } else {
        text = text + _t("- User preferences: (empty)\n", "- 用户偏好: （空）\n")
    }
    text = text + _t("\nMemory files: .helen/MEMORY.md, .helen/USER.md\n", "\n记忆文件: .helen/MEMORY.md, .helen/USER.md\n")
    return text
}

// ── v1.19-v1.20 新增命令 ────────────────────────────────────────

/** /context - 显示上下文状态 */
fn _cmd_context(): str {
    let text = _t("## Context Status\n\n", "## 上下文状态\n\n")
    let stats = ContextManager.get_stats()
    if stats["status"] == "ok" {
        text = text + _t("- Messages: ", "- 消息数: ") + str(stats["message_count"]) + "\n"
        text = text + _t("- Total tokens: ", "- 总 tokens: ") + str(stats["total_tokens"]) + "\n"
        let usage_pct = int(stats["usage_ratio"] * 100)
        text = text + _t("- Context usage: ", "- 上下文占用: ") + str(usage_pct) + "%\n"
        text = text + _t("- Pinned messages: ", "- 钉住消息: ") + str(stats["pinned_count"]) + "\n"
        let wm = stats["working_memory"]
        if wm != null && len(wm) > 0 {
            // 统计非空字段（wm 是 data 字段：{task, active_files, decisions, todos, errors}）
            let non_empty = 0
            for key in keys(wm) {
                let v = wm[key]
                if v != "" && len(v) > 0 {
                    non_empty = non_empty + 1
                }
            }
            text = text + _t("- Working memory entries: ", "- 工作记忆条目: ") + str(non_empty) + "/" + str(len(keys(wm))) + "\n"
        }
    } else {
        text = text + _t("Context statistics unavailable (", "上下文统计不可用（") + str(stats["error"]) + _t(")\n", "）\n")
    }
    text = text + _t("- Helen version: v", "- Helen 版本: v") + ContextManager.get_version() + "\n"
    let session_dir = ContextManager.get_session_dir()
    if session_dir != "" {
        text = text + _t("- Session dir: ", "- 会话目录: ") + session_dir + "\n"
    } else {
        text = text + _t("- Session dir: ~/.helen/sessions/ (global)\n", "- 会话目录: ~/.helen/sessions/（全局）\n")
    }
    return text
}

/** /version - 显示 Helen 语言版本 */
fn _cmd_version(): str {
    return _t("Helen language version: v", "Helen 语言版本: v") + ContextManager.get_version()
}

/** /session [subcommand] - 会话管理
 *
 * 子命令：
 *   (无参数)         显示当前会话信息（向后兼容）
 *   list [--limit N] [--offset N]
 *                    列出所有会话，标记当前/空
 *   delete <sid>     删除指定会话（级联删除 spawn 树）
 *   view <sid> [--limit N] [--offset N]
 *                    显示指定会话的用户消息 */
fn _cmd_session(args: list): str {
    if len(args) == 0 {
        return _cmd_session_info()
    }
    let sub = args[0]
    let rest = []
    let i = 1
    while i < len(args) {
        rest = rest + [args[i]]
        i = i + 1
    }
    match sub {
        case "info" {
            return _cmd_session_info()
        }
        case "list" {
            return _cmd_session_list(rest)
        }
        case "delete" {
            return _cmd_session_delete(rest)
        }
        case "view" {
            return _cmd_session_view(rest)
        }
        default {
            return _t("❌ Unknown /session subcommand: ", "❌ 未知 /session 子命令: ") + sub + "\n" +
                   _t("Available: info, list, delete, view", "可用: info, list, delete, view")
        }
    }
}

/** /session info - 显示当前会话信息（原 /session 行为） */
fn _cmd_session_info(): str {
    let text = _t("## Session Info\n\n", "## 会话信息\n\n")
    try {
        let sid = get_session_id()
        if sid != null && sid != "" {
            text = text + _t("- Session ID: ", "- 会话 ID: ") + sid + "\n"
        } else {
            text = text + _t("- Session ID: (not initialized)\n", "- 会话 ID: （未初始化）\n")
        }
    } catch {
        text = text + _t("- Session ID: (unavailable)\n", "- 会话 ID: （不可用）\n")
    }
    let session_dir = ContextManager.get_session_dir()
    if session_dir != "" {
        text = text + _t("- Session dir: ", "- 会话目录: ") + session_dir + "\n"
    } else {
        text = text + _t("- Session dir: ~/.helen/sessions/ (global)\n", "- 会话目录: ~/.helen/sessions/（全局）\n")
    }
    if session_dir != "" && path_exists(session_dir) {
        try {
            let files = list_dir(session_dir)
            // 只统计有 transcript.jsonl 的目录（排除空目录）
            let transcript_count = 0
            for f in files {
                let transcript_path = path_join(session_dir, f, "transcript.jsonl")
                if path_exists(transcript_path) {
                    transcript_count = transcript_count + 1
                }
            }
            text = text + _t("- Transcript files: ", "- transcript 文件: ") + str(transcript_count) + "\n"
        } catch {
            text = text + _t("- Transcript files: (cannot read)\n", "- transcript 文件: （无法读取）\n")
        }
    }
    return text
}

/** /pin <uuid> - 钉住消息 */
fn _cmd_pin(args: list): str {
    if len(args) == 0 {
        let pinned = ContextManager.get_pinned()
        if len(pinned) == 0 {
            return _t("No pinned messages.\nUsage: /pin <uuid> to pin a message, making it immune to compression", "当前没有钉住的消息。\n用法: /pin <uuid> 钉住消息，使其免疫压缩")
        }
        let text = _t("Pinned messages (", "已钉住的消息（") + str(len(pinned)) + _t("):\n", " 条）:\n")
        for uuid in pinned {
            text = text + "  • " + str(uuid) + "\n"
        }
        return text
    }
    let uuid = args[0]
    if ContextManager.pin(uuid) {
        return _t("✅ Pinned message: ", "✅ 已钉住消息: ") + uuid + _t("\nThis message will be preserved during context compression", "\n该消息将在上下文压缩时被保留")
    }
    return _t("❌ Pin failed (message does not exist or API unavailable)", "❌ 钉住失败（消息不存在或 API 不可用）")
}

/** /unpin <uuid> - 取消钉住消息 */
fn _cmd_unpin(args: list): str {
    if len(args) == 0 {
        let pinned = ContextManager.get_pinned()
        if len(pinned) == 0 {
            return _t("No pinned messages.\nUsage: /unpin <uuid> to unpin a message", "当前没有钉住的消息。\n用法: /unpin <uuid> 取消钉住指定消息")
        }
        let text = _t("Pinned messages (", "已钉住的消息（") + str(len(pinned)) + _t("):\n", " 条）:\n")
        for uuid in pinned {
            text = text + "  • " + str(uuid) + "\n"
        }
        return text + _t("\nUsage: /unpin <uuid> to unpin a message", "\n用法: /unpin <uuid> 取消钉住指定消息")
    }
    let uuid = args[0]
    if ContextManager.unpin(uuid) {
        return _t("✅ Unpinned: ", "✅ 已取消钉住: ") + uuid
    }
    return _t("❌ Unpin failed (message not in pinned list or API unavailable)", "❌ 取消钉住失败（消息不在钉住列表中或 API 不可用）")
}

/** /search <query> - 搜索上下文
 *  v1.23：改用 search_transcript 直接搜磁盘上的 transcript 文件，
 *  不依赖内存 store（解决"首次请求即 /search"时 store 空的 corner case，
 *  以及 Per-Main Fresh Context 下斜杠命令分支看不到 LLM 历史的问题）。 */
fn _cmd_search(args: list): str {
    if len(args) == 0 {
        return _t("Usage: /search <query>\nSearch matching messages in the current session's persistent transcript", "用法: /search <query>\n在当前会话的持久化 transcript 中搜索匹配的消息")
    }
    let query = join(args, " ")
    let text = ""
    try {
        let sid = get_session_id()
        let matches = search_transcript(query, sid, "current", "", false, 10)
        if matches == null || len(matches) == 0 {
            text = _t("## Search Results\n\nNo messages found matching '", "## 搜索结果\n\n未找到匹配 '") + query + _t("'", "'")
        } else {
            text = _t("## Search Results\n\n", "## 搜索结果\n\n") + _t("Matched ", "匹配 ") + str(len(matches)) + _t(" results:\n\n", " 条:\n\n")
            for msg in matches {
                let role = msg["role"]
                let uuid = msg["message_uuid"]
                let snippet = msg["snippet"]
                text = text + "**[" + str(role) + "]** " + str(snippet) + "\n"
                text = text + "- UUID: `" + str(uuid) + "`\n\n"
            }
            text = text + _t("Tip: Use `/pin <uuid>` to pin important messages, preserving them during context compression", "提示：使用 `/pin <uuid>` 钉住重要消息，使其在上下文压缩时被保留")
        }
    } catch RuntimeError err {
        text = _t("## Search Failed\n\n- Error: ", "## 搜索失败\n\n- 错误: ") + err.message
    } catch {
        text = _t("## Search Failed\n\n- Reason: search_transcript() unavailable, requires Helen v1.22+", "## 搜索失败\n\n- 原因: search_transcript() 不可用，需要 Helen v1.22+")
    }
    return text
}

/** /mode [name] — 查看或切换输出模式
 *  用法:
 *    /mode              显示当前模式和可用模式列表
 *    /mode <name>       切换到指定模式（minimal / normal / verbose / rich） */
fn _cmd_mode(args: list): str {
    let available = ["minimal", "normal", "verbose", "rich"]
    if len(args) == 0 {
        let current = get_output_mode()
        let text = _t("## Output Mode\n\n", "## 输出模式\n\n")
        text = text + _t("Current mode: **", "当前模式: **") + current + _t("**\n\n", "**\n\n")
        text = text + _t("Available modes:\n", "可用模式:\n")
        for m in available {
            if m == current {
                text = text + "- **" + m + "** " + _t("(current)\n", "（当前）\n")
            } else {
                text = text + "- " + m + "\n"
            }
        }
        text = text + _t("\nUsage: `/mode <name>` to switch to a specific mode", "\n用法: `/mode <name>` 切换到指定模式")
        return text
    }
    let target = args[0]
    let ok = set_output_mode(target)
    if ok {
        return _t("✅ Switched to output mode: **", "✅ 已切换到输出模式: **") + target + "**"
    }
    return _t("❌ Unknown output mode: ", "❌ 未知输出模式: ") + target + _t("\n\nAvailable modes: minimal, normal, verbose, rich", "\n\n可用模式: minimal, normal, verbose, rich")
}

/** /working-memory — 查看工作记忆内容
 *  用法:
 *    /working-memory         显示所有工作记忆条目
 *    /working-memory get <key>  显示指定 key 的值
 *    /working-memory stats   显示统计信息 */
fn _cmd_working_memory(args: list): str {
    if len(args) == 0 {
        // 显示所有工作记忆
        let text = _t("## Working Memory\n\n", "## 工作记忆\n\n")
        try {
            let result = working_memory_get()
            // working_memory_get() 返回 {"status": "ok", "data": {...}}
            if result["status"] != "ok" {
                return text + _t("❌ Unavailable: ", "❌ 不可用: ") + str(result["error"])
            }
            let wm = result["data"]
            // 检查是否为空（所有字段都为空）
            let has_content = false
            for key in keys(wm) {
                let v = wm[key]
                if v != "" && len(v) > 0 {
                    has_content = true
                }
            }
            if !has_content {
                return text + _t("(empty)", "（空）")
            }
            text = text + _t("### Current Content\n\n", "### 当前内容\n\n")
            let sorted_keys = sort(keys(wm))
            for key in sorted_keys {
                let value = wm[key]
                // 空字段不显示
                if value == "" || len(value) == 0 {
                    continue
                }
                text = text + "- **" + key + "**: " + str(value) + "\n"
            }
            return text
        } catch RuntimeError err {
            return text + _t("(unavailable - working_memory_get() requires Helen v1.19+: ", "（不可用 - working_memory_get() 需要 Helen v1.19+: ") + err.message + _t(")", "）")
        } catch {
            return text + _t("(unavailable - working_memory_get() requires Helen v1.19+)", "（不可用 - working_memory_get() 需要 Helen v1.19+）")
        }
    }

    if args[0] == "get" && len(args) > 1 {
        let key = args[1]
        try {
            let result = working_memory_get(key)
            // working_memory_get(key) 返回 {"status": "ok", "data": <value>}
            if result["status"] != "ok" {
                return _t("❌ Get failed: ", "❌ 获取失败: ") + str(result["error"])
            }
            let value = result["data"]
            if value == null {
                return _t("Key not found: ", "未找到 key: ") + key
            }
            return "**" + key + "**: " + str(value)
        } catch {
            return _t("❌ Get failed (working_memory_get() unavailable)", "❌ 获取失败（working_memory_get() 不可用）")
        }
    }

    if args[0] == "stats" {
        let text = _t("## Working Memory Statistics\n\n", "## 工作记忆统计\n\n")
        try {
            let result = working_memory_get()
            if result["status"] != "ok" {
                return text + _t("(unavailable)", "（不可用）")
            }
            let wm = result["data"]
            // 统计非空字段数
            let non_empty = 0
            let total_size = 0
            for key in keys(wm) {
                let v = wm[key]
                if v != "" && len(v) > 0 {
                    non_empty = non_empty + 1
                }
                total_size = total_size + len(key) + len(str(v))
            }
            text = text + _t("- Non-empty fields: ", "- 非空字段: ") + str(non_empty) + "/" + str(len(keys(wm))) + "\n"
            text = text + _t("- Total size: ", "- 总大小: ") + str(total_size) + " bytes\n"
            return text
        } catch {
            return text + _t("(unavailable)", "（不可用）")
        }
    }

    return _t("Usage: /working-memory [get <key>|stats]", "用法: /working-memory [get <key>|stats]")
}

/** /goal <text> — 自主 Pursue 目标
 *  WebUI 中由后端拦截并运行 goal loop。
 *  CLI/REPL 中此命令不可用（需要 WebSocket 支持）。 */
fn _cmd_goal(args: list): str {
    if len(args) == 0 {
        return _t(
            "Usage: /goal <goal description>\nExample: /goal Write a Python calculator\n\nNote: This command is only available in the WebUI. In CLI/REPL, please describe your goal directly in the conversation.",
            "用法: /goal <目标描述>\n示例: /goal 写一个 Python 计算器\n\n注意: 此命令仅在 WebUI 中可用。在 CLI/REPL 中，请直接在对话中描述你的目标。"
        )
    }
    // WebUI 中此命令不会到达这里（被 chat.py 拦截）
    // CLI/REPL 中返回提示
    return _t(
        "⚠️ The /goal command is only available in the WebUI.\n\nIn CLI/REPL, please describe your goal directly in the conversation, and the agent will work toward it.",
        "⚠️ /goal 命令仅在 WebUI 中可用。\n\n在 CLI/REPL 中，请直接在对话中描述你的目标，agent 会朝它努力。"
    )
}

// ── /session 子命令 ────────────────────────────────────────────────

/** 解析模糊 session ID（支持完整 ID、前缀、或含 "…" 的短 ID）
 *  短 ID 格式: "session_xxxx…yyyy"（前缀 + 后缀，中间省略）
 *  返回完整 session_id，找不到返回 "" */
fn _resolve_session_id(partial: str): str {
    // 如果输入已经是完整 session_id（长度 > 30 且以 session_ 开头，无 "…"），直接返回
    if startswith(partial, "session_") && len(partial) > 30 && !contains(partial, "…") {
        return partial
    }

    // 去掉反引号
    let cleaned = replace(partial, "`", "")

    // 用 _collect_all_sessions 直接读目录（list_sessions 在 agent 内 scope 解析有问题）
    let candidates = _collect_all_sessions()

    // 判断是否为短 ID（含 "…"）
    if contains(cleaned, "…") {
        let parts = split(cleaned, "…")
        if len(parts) == 2 {
            let prefix = parts[0]
            let suffix = parts[1]
            // 匹配：以 prefix 开头 且 以 suffix 结尾
            let matches = []
            for s in candidates {
                let sid = s["session_id"]
                if startswith(sid, prefix) && endswith(sid, suffix) {
                    matches = matches + [sid]
                }
            }
            if len(matches) == 1 {
                return matches[0]
            }
            return ""
        }
    }

    // 不是短 ID：作为普通前缀/子串匹配
    // 优先精确匹配
    for s in candidates {
        let sid = s["session_id"]
        if sid == cleaned {
            return sid
        }
    }

    // 模糊匹配：输入是 session_id 的子串
    let matches = []
    for s in candidates {
        let sid = s["session_id"]
        if contains(sid, cleaned) || startswith(sid, cleaned) || endswith(sid, cleaned) {
            matches = matches + [sid]
        }
    }

    // 唯一匹配 → 返回；多个匹配 → 返回 ""
    if len(matches) == 1 {
        return matches[0]
    }
    return ""
}

/** 解析 --limit N 和 --offset N 参数
 *  返回: {"limit": int, "offset": int, "rest": list} */
fn _parse_pagination(args: list): map {
    let limit = 20
    let offset = 0
    let rest = []
    let i = 0
    while i < len(args) {
        if args[i] == "--limit" && i + 1 < len(args) {
            try { limit = int(args[i + 1]) } catch {}
            i = i + 2
        } else if args[i] == "--offset" && i + 1 < len(args) {
            try { offset = int(args[i + 1]) } catch {}
            i = i + 2
        } else {
            rest = rest + [args[i]]
            i = i + 1
        }
    }
    return {"limit": limit, "offset": offset, "rest": rest}
}

/** 格式化 Unix 时间戳为 YYYY-MM-DD HH:MM */
fn _format_ts(ts): str {
    try {
        let dt = fromtimestamp(ts)
        return date_format(dt, "%Y-%m-%d %H:%M")
    } catch {
        return str(ts)
    }
}

/** /session list — 列出所有 session */

/** 收集所有 session（project + global scope，去重） */
fn _collect_all_sessions(): list {
    // 用 stdlib list_sessions() 收集（v1.43 修复了 HELEN_SESSION_DIR 覆盖
    // 显式 scope 的问题，list_sessions("global") 现在返回真实全局 session）
    let seen_ids = {}
    let all = []
    for s in list_sessions("global") {
        let sid = s["session_id"]
        let dup = false
        try { if seen_ids[sid] { dup = true } } catch {}
        if !dup {
            all = all + [s]
            seen_ids[sid] = true
        }
    }
    for s in list_sessions("project") {
        let sid = s["session_id"]
        let dup = false
        try { if seen_ids[sid] { dup = true } } catch {}
        if !dup {
            all = all + [s]
            seen_ids[sid] = true
        }
    }
    return all
}

/** 检查 target session 是否被任何 memento 引用
 *  扫描 <cwd>/.helen/current_session_id（主 memento）
 *  返回引用它的 memento 路径，未引用返回 "" */
fn _find_memento_reference(target: str): str {
    let cwd = get_cwd()
    let home = env_get("HOME", "")
    if home == "" { home = env_get("USERPROFILE", "") }

    // 收集可能的 memento 路径（当前 cwd + home 下的 .helen）
    let memento_paths = []
    let cwd_memento = path_join(cwd, ".helen", "current_session_id")
    if path_exists(cwd_memento) {
        memento_paths = memento_paths + [cwd_memento]
    }
    if home != "" {
        let home_memento = path_join(home, ".helen", "current_session_id")
        if path_exists(home_memento) {
            // 避免重复添加（当 cwd == home 时）
            if home_memento != cwd_memento {
                memento_paths = memento_paths + [home_memento]
            }
        }
    }

    for memento_path in memento_paths {
        try {
            let content = read_file(memento_path)
            let trimmed = strip(content)
            // JSON 格式: {"main": "sid1", "child": "sid2"}
            if startswith(trimmed, "{") {
                let data = json_parse(trimmed)
                let main_sid = ""
                let child_sid = ""
                try { main_sid = data["main"] } catch {}
                try { child_sid = data["child"] } catch {}
                if main_sid == target || child_sid == target {
                    return memento_path
                }
            } else if trimmed == target {
                // 旧格式：纯文本 session_id
                return memento_path
            }
        } catch {
            // 读取失败，跳过
        }
    }
    return ""
}

fn _cmd_session_list(args: list): str {
    let pg = _parse_pagination(args)
    let limit = pg["limit"]
    let offset = pg["offset"]

    let all = _collect_all_sessions()

    if len(all) == 0 {
        return _t("No sessions found.", "没有找到会话。")
    }

    let current_sid = ""
    try { current_sid = get_session_id() } catch {}

    let total = len(all)
    let text = _t("## Sessions\n\n", "## 会话列表\n\n")
    text = text + _t("Total: ", "总计: ") + str(total) + _t(" sessions", " 个会话")
    if offset > 0 || limit < total {
        text = text + _t(" (showing ", "（显示 ") + str(offset + 1) + "-" + str(min(offset + limit, total)) + ")"
    }
    text = text + "\n\n"
    text = text + _t("| # | Session ID | Created | Msgs | Size | Scope | Status |\n", "| # | 会话 ID | 创建时间 | 消息数 | 大小 | 范围 | 状态 |\n")
    text = text + "|---|-----------|---------|------|------|-------|--------|\n"

    let i = offset
    let shown = 0
    while i < len(all) && shown < limit {
        let s = all[i]
        let sid = s["session_id"]
        let created = _format_ts(s["created_at"])
        let msg_count = s["message_count"]
        let size_bytes = s["size_bytes"]
        let scope = s["scope"]

        let status = ""
        if sid == current_sid {
            status = _t("🔵 current", "🔵 当前")
        } else if msg_count > 1 {
            status = _t("💬 messages", "💬 有消息")
        } else {
            status = _t("⚪ empty", "⚪ 空")
        }

        // 大小格式化
        let size_str = ""
        if size_bytes < 1024 {
            size_str = str(size_bytes) + "B"
        } else if size_bytes < 1024 * 1024 {
            size_str = str(int(size_bytes / 1024)) + "KB"
        } else {
            size_str = str(int(size_bytes / (1024 * 1024))) + "MB"
        }

        // 缩短 session id 显示（前 8 字符 + 后 8 字符）
        let short_sid = sid
        if len(sid) > 24 {
            short_sid = substring(sid, 0, 12) + "…" + substring(sid, len(sid) - 8, len(sid))
        }

        text = text + "| " + str(i + 1) + " | `" + short_sid + "` | " + created + " | " + str(msg_count) + " | " + size_str + " | " + scope + " | " + status + " |\n"
        i = i + 1
        shown = shown + 1
    }

    text = text + "\n" + _t("Usage: `/session view <sid>` to view messages, `/session delete <sid>` to delete", "用法: `/session view <sid>` 查看消息, `/session delete <sid>` 删除")
    return text
}

/** /session delete <sid> — 删除指定 session */
fn _cmd_session_delete(args: list): str {
    if len(args) == 0 {
        return _t("Usage: /session delete <session_id>\nDelete a session and its spawned sessions (cascade).\nAccepts full ID, prefix, or short ID with '…'.", "用法: /session delete <session_id>\n删除指定会话及其 spawn 树（级联）。\n支持完整 ID、前缀、或含 '…' 的短 ID。")
    }
    let target_input = args[0]

    // 解析模糊 session ID
    let target = _resolve_session_id(target_input)
    if target == "" {
        return _t("❌ Cannot uniquely resolve session: ", "❌ 无法唯一确定会话: ") + target_input + "\n" +
               _t("Tip: copy full ID from `/session list` output, or use enough prefix to be unique", "提示: 从 `/session list` 输出复制完整 ID，或用足够长的唯一前缀")
    }

    // 禁止删除当前 session
    let current_sid = ""
    try { current_sid = get_session_id() } catch {}
    if target == current_sid {
        return _t("❌ Cannot delete the current session. Use `/clear-session` instead if you want to reset.", "❌ 不能删除当前会话。如需重置请使用 `/clear-session`。")
    }

    // 在所有 session 中查找（绕过 list_sessions scope bug）
    let all = _collect_all_sessions()
    let target_info = null
    for s in all {
        if s["session_id"] == target {
            target_info = s
            break
        }
    }
    if target_info == null {
        return _t("❌ Session not found: ", "❌ 未找到会话: ") + target
    }

    // ── 安全检查 ─────────────────────────────────────────────
    // 1. 禁止删除被任何 memento 引用的 session（main 或 child）
    //    memento 位置：<cwd>/.helen/current_session_id 和 ~/<project>/.helen/current_session_id
    //    但扫描所有可能目录成本高，只检查已知的 memento
    let memento_ref = _find_memento_reference(target)
    if memento_ref != "" {
        return _t("❌ Cannot delete: session is referenced by memento at ", "❌ 无法删除: 会话被 memento 引用: ") + memento_ref + "\n" +
               _t("   This session is part of the active parent-child architecture.", "   此会话是活跃的主子 session 架构的一部分。")
    }

    // 2. 禁止删除有子 session 的 parent session（会破坏 spawn 树）
    let children = []
    for s in all {
        let parent = ""
        try { parent = s["parent_session_id"] } catch {}
        if parent == target {
            children = children + [s["session_id"]]
        }
    }
    if len(children) > 0 {
        return _t("❌ Cannot delete: session has ", "❌ 无法删除: 会话有 ") + str(len(children)) + _t(" child session(s):\n", " 个子会话:\n") +
               _t("   ", "   ") + join(children, ", ") + "\n" +
               _t("   Deleting parent would orphan child sessions with active transcripts.", "   删除父会话会使子会话孤立（它们有活跃的 transcript）。")
    }

    // 执行删除：直接删目录（delete_session 只查当前 scope，跨 scope 删不了）
    let header = _t("## Session Deletion\n\n", "## 会话删除\n\n")
    let session_dir = path_join(target_info["dir"], target)
    try {
        delete_dir(session_dir, recursive=true)
        let text = header
        text = text + _t("- Session: ", "- 会话: ") + target + "\n"
        text = text + _t("- Directory: ", "- 目录: ") + session_dir + "\n"
        text = text + _t("- Action: ✅ Deleted\n", "- 操作: ✅ 已删除\n")
        return text
    } catch RuntimeError err {
        return header + _t("- Action: ❌ Failed\n- Error: ", "- 操作: ❌ 失败\n- 错误: ") + err.message + "\n"
    } catch {
        return header + _t("- Action: ❌ Failed\n", "- 操作: ❌ 失败\n")
    }
}

/** /session view <sid> — 显示指定 session 的用户消息 */
fn _cmd_session_view(args: list): str {
    let pg = _parse_pagination(args)
    let limit = pg["limit"]
    let offset = pg["offset"]
    let rest = pg["rest"]

    if len(rest) == 0 {
        return _t("Usage: /session view <session_id> [--limit N] [--offset N]\nShow user messages in the specified session.\nAccepts full ID, prefix, or short ID with '…'.", "用法: /session view <session_id> [--limit N] [--offset N]\n显示指定会话的用户消息。\n支持完整 ID、前缀、或含 '…' 的短 ID。")
    }
    let target_input = rest[0]

    // 解析模糊 session ID
    let target = _resolve_session_id(target_input)
    if target == "" {
        return _t("❌ Cannot uniquely resolve session: ", "❌ 无法唯一确定会话: ") + target_input + "\n" +
               _t("Tip: copy full ID from `/session list` output, or use enough prefix to be unique", "提示: 从 `/session list` 输出复制完整 ID，或用足够长的唯一前缀")
    }

    // 在所有 session 中查找目标（_collect_all_sessions 直接读目录，含 dir 信息）
    let all_sessions = _collect_all_sessions()
    let target_info = null
    for s in all_sessions {
        if s["session_id"] == target {
            target_info = s
            break
        }
    }
    if target_info == null {
        return _t("❌ Session not found: ", "❌ 未找到会话: ") + target
    }

    // 读取 transcript 并过滤 role=user
    // 若当前 session 无用户消息，沿 parent_session_id 链向上找（主子 session 架构）
    let user_messages = []
    let viewed_sid = target
    let search_sid = target
    let hops = 0
    while search_sid != "" && hops < 5 {
        let session_dir = ""
        let parent_sid = ""
        // 在 all_sessions 里找 search_sid 的目录和 parent
        for s in all_sessions {
            if s["session_id"] == search_sid {
                session_dir = path_join(s["dir"], search_sid)
                try { parent_sid = s["parent_session_id"] } catch {}
                break
            }
        }
        if session_dir == "" {
            break
        }
        let transcript_path = path_join(session_dir, "transcript.jsonl")
        if !path_exists(transcript_path) {
            break
        }
        try {
            let content = read_file(transcript_path)
            let lines = split(content, "\n")
            for line in lines {
                if strip(line) == "" {
                    continue
                }
                try {
                    let msg = json_parse(line)
                    if msg["role"] == "user" {
                        user_messages = user_messages + [msg]
                    }
                } catch {
                    // 跳过解析失败的行
                }
            }
        } catch {
            break
        }
        if len(user_messages) > 0 {
            viewed_sid = search_sid
            break
        }
        // 当前 session 无消息，沿 parent 链向上找
        search_sid = parent_sid
        hops = hops + 1
    }

    if len(user_messages) == 0 {
        let not_found_msg = _t("No user messages found in session: ", "该会话中没有用户消息: ") + target
        if viewed_sid != target {
            not_found_msg = not_found_msg + _t("\n(also checked parent chain)", "\n（已沿父链查找）")
        }
        return not_found_msg
    }

    // 分页输出
    let total = len(user_messages)
    let text = _t("## User messages in session\n\n", "## 会话中的用户消息\n\n")
    text = text + _t("Session: ", "会话: ") + "`" + target + "`\n"
    text = text + _t("Total user messages: ", "用户消息总数: ") + str(total)
    if offset > 0 || limit < total {
        text = text + _t(" (showing ", "（显示 ") + str(offset + 1) + "-" + str(min(offset + limit, total)) + ")"
    }
    text = text + "\n\n---\n\n"

    let i = offset
    let shown = 0
    while i < len(user_messages) && shown < limit {
        let msg = user_messages[i]
        let msg_content = str(msg["content"])
        let uuid = ""
        try { uuid = msg["uuid"] } catch {}

        // 提取用户实际输入：Helen agent prompt 通常以固定 reminder 段结尾，
        // 用户输入在其后。用 split 取最后一段（按 "## Reminders" 切分）。
        // 如果切分失败，显示最后 500 字符作为用户输入。
        let user_input = msg_content
        let chunks = split(msg_content, "## Reminders")
        if len(chunks) > 1 {
            let last_chunk = chunks[len(chunks) - 1]
            // 再按双换行切，取最后一段（跳过 reminder 条目）
            let paragraphs = split(last_chunk, "\n\n")
            if len(paragraphs) > 1 {
                user_input = strip(paragraphs[len(paragraphs) - 1])
            } else {
                user_input = strip(last_chunk)
            }
        }
        // 兜底：如果提取结果为空或仍太长（> 800 字符），取最后 500 字符
        if user_input == "" || len(user_input) > 800 {
            if len(msg_content) > 500 {
                user_input = "..." + substring(msg_content, len(msg_content) - 500, len(msg_content))
            }
        }

        // 截短过长内容（超过 1000 字符显示省略）
        if len(user_input) > 1000 {
            user_input = substring(user_input, 0, 1000) + "\n... (" + _t("truncated", "已截断") + ")"
        }

        text = text + "**[" + str(i + 1) + "/" + str(total) + "]**"
        if uuid != "" {
            text = text + " `" + uuid + "`"
        }
        text = text + "\n\n" + user_input + "\n\n---\n\n"

        i = i + 1
        shown = shown + 1
    }

    text = text + _t("Tip: Use `--offset N` to paginate, `--limit N` to change page size", "提示: 用 `--offset N` 翻页, `--limit N` 调整每页大小")
    return text
}
