// ═══════════════════════════════════════════════════════════════════
// output.helen 单元测试
// ═══════════════════════════════════════════════════════════════════
//
// 测试输出管理器的各种功能：
// - 输出模式切换
// - 颜色支持检测
// - 输出级别控制
//

import std.core.*
import "../output.helen"

// ── 测试辅助函数 ────────────────────────────────────────────────

fn _test_assert_equal(actual: str, expected: str, test_name: str) {
    if actual == expected {
        print("✓ " + test_name + ": PASS")
    } else {
        print("✗ " + test_name + ": FAIL")
        print("  Expected: " + expected)
        print("  Actual:   " + actual)
    }
}

fn _test_assert_true(condition: bool, test_name: str) {
    if condition {
        print("✓ " + test_name + ": PASS")
    } else {
        print("✗ " + test_name + ": FAIL")
    }
}

// ── 测试用例 ────────────────────────────────────────────────────

fn _test_output_mode_switching() {
    print("\n=== 测试输出模式切换 ===")

    // 测试默认模式
    set_output_mode("minimal")
    _test_assert_equal(get_output_mode(), "minimal", "默认模式为 minimal")

    // 测试切换到 normal
    set_output_mode("normal")
    _test_assert_equal(get_output_mode(), "normal", "切换到 normal 模式")

    // 测试切换到 verbose
    set_output_mode("verbose")
    _test_assert_equal(get_output_mode(), "verbose", "切换到 verbose 模式")

    // 测试切换到 rich
    set_output_mode("rich")
    _test_assert_equal(get_output_mode(), "rich", "切换到 rich 模式")

    // 测试无效模式
    let result = set_output_mode("invalid")
    _test_assert_true(!result, "无效模式返回 false")
    _test_assert_equal(get_output_mode(), "rich", "无效模式不改变当前模式")

    // 重置为 minimal
    set_output_mode("minimal")
}

fn _test_output_level() {
    print("\n=== 测试输出级别 ===")

    // 测试级别常量
    _test_assert_true(OUTPUT_MINIMAL == 0, "OUTPUT_MINIMAL = 0")
    _test_assert_true(OUTPUT_NORMAL == 1, "OUTPUT_NORMAL = 1")
    _test_assert_true(OUTPUT_VERBOSE == 2, "OUTPUT_VERBOSE = 2")

    // 测试 set_output_level
    set_output_level(OUTPUT_VERBOSE)
    _test_assert_true(get_output_level() == OUTPUT_VERBOSE, "set_output_level 设置正确")

    // 重置
    set_output_level(OUTPUT_MINIMAL)
}

fn _test_color_support() {
    print("\n=== 测试颜色支持 ===")

    // 测试颜色启用
    init_output()
    // 颜色支持取决于终端环境，这里只测试函数不崩溃
    print("✓ init_output() 执行成功")
}

fn _test_output_functions() {
    print("\n=== 测试输出函数 ===")

    // 设置 minimal 模式以测试基本输出
    set_output_mode("minimal")

    // 测试各种输出函数（只测试不崩溃）
    status("测试状态消息")
    success("测试成功消息")
    warning("测试警告消息")
    error("测试错误消息")
    info("测试信息消息")

    print("✓ 所有输出函数执行成功")
}

fn _test_agent_output() {
    print("\n=== 测试 Agent 输出 ===")

    set_output_mode("minimal")

    // 测试 agent_start 和 agent_end
    agent_start("TestAgent")
    agent_end("TestAgent")

    print("✓ Agent 输出函数执行成功")
}

fn _test_llm_stream_output() {
    print("\n=== 测试 LLM 流式输出 ===")

    set_output_mode("minimal")

    // 重置 LLM 输出状态
    reset_llm_output_state()

    // 测试智能 LLM 输出
    smart_llm_chunk("这是一个测试 chunk")
    smart_llm_chunk("\n")
    smart_llm_chunk("另一个 chunk")
    smart_llm_complete()

    print("✓ LLM 流式输出函数执行成功")
}

// ── 主测试函数 ──────────────────────────────────────────────────

main {
    print("╔═══════════════════════════════════════════════════════════╗")
    print("║         output.helen 单元测试                            ║")
    print("╚═══════════════════════════════════════════════════════════╝")

    // 运行所有测试
    _test_output_mode_switching()
    _test_output_level()
    _test_color_support()
    _test_output_functions()
    _test_agent_output()
    _test_llm_stream_output()

    print("\n╔═══════════════════════════════════════════════════════════╗")
    print("║         测试完成                                          ║")
    print("╚═══════════════════════════════════════════════════════════╝")
}
