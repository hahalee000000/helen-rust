// ═══════════════════════════════════════════════════════════════════
// 测试: chat_session_actor.helen 的 functions{} 工具函数
// ═══════════════════════════════════════════════════════════════════
//
// 运行: helen helen/agent/tests/test_chat_session_actor_tools.helen
//
// 本测试利用 v1.42 新增的静态 agent 函数调用语法：
//   ChatSessionActor.function_name(args)
// 直接调用 agent 的工具函数，无需实例化 agent、无需 LLM 调用。
//

import std.core.*
import std.str.*
import std.path.*
import std.io.*
import std.file.*
import std.data.*
import std.tools.*
import std.time.*
import "../chat_session_actor.helen"

fn _assert(condition: bool, test_name: str) {
    if condition {
        print("✓ " + test_name)
    } else {
        print("✗ FAIL: " + test_name)
    }
}

fn _assert_equal(actual: any, expected: any, test_name: str) {
    if str(actual) == str(expected) {
        print("✓ " + test_name)
    } else {
        print("✗ FAIL: " + test_name + " (expected '" + str(expected) + "', got '" + str(actual) + "')")
    }
}

// ── 路径校验（invalid path fast path）──────────────────────────

fn test_get_scores_invalid_path() {
    print("\n=== get_scores rejects invalid path ===")
    let r = ChatSessionActor.get_scores("file; rm -rf /")
    _assert_equal(r["syntax_error"], true, "syntax_error = true")
    _assert(contains(str(r["syntax_output"]), "invalid"), "error message mentions invalid")
}

fn test_run_helen_check_invalid_path() {
    print("\n=== run_helen_check rejects invalid path ===")
    let r = ChatSessionActor.run_helen_check("bad;path")
    _assert_equal(r["valid"], false, "valid = false")
    _assert(contains(str(r["output"]), "invalid"), "output mentions invalid")
}

fn test_run_helen_tests_invalid_path() {
    print("\n=== run_helen_tests rejects invalid path ===")
    let r = ChatSessionActor.run_helen_tests("bad;path")
    _assert_equal(r["success"], false, "success = false")
    _assert(contains(str(r["output"]), "invalid"), "output mentions invalid")
}

// ── 真实文件操作 ──────────────────────────────────────────────

fn test_run_helen_check_real_file() {
    print("\n=== run_helen_check on real file ===")
    let r = ChatSessionActor.run_helen_check("contracts/contracts.helen")
    _assert(r["valid"] == true || r["valid"] == false, "returns boolean valid")
    _assert(len(str(r["output"])) >= 0, "returns output (may be empty for valid files)")
}

fn test_save_code_file() {
    print("\n=== save_code_file writes content ===")
    let tmp_path = "/tmp/helen_test_save_" + str(int(time())) + ".helen"
    let r = ChatSessionActor.save_code_file(tmp_path, "// test\nmain { }\n")
    _assert(r["status"] == "written" || r["status"] == "success", "status is written or success (got: " + str(r["status"]) + ")")
    _assert(path_exists(tmp_path), "file created")

    let content = read_file(tmp_path)
    _assert(contains(content, "test"), "content written")

    // 清理
    try { delete_file(tmp_path) } catch {}
}

fn test_create_project_structure() {
    print("\n=== create_project_structure creates directories ===")
    let tmp = "/tmp/helen_test_project_" + str(int(time()))
    mkdir_p(tmp)
    let r = ChatSessionActor.create_project_structure(tmp, "TestProject")
    _assert(r["task_id"] != null && r["task_id"] != "", "task_id is set")
    _assert(r["task_dir"] != null && r["task_dir"] != "", "task_dir is set")

    // 清理
    try { shell_exec("rm -rf " + tmp) } catch {}
}

