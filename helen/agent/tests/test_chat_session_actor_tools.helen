fn test_save_new_skill_and_update() {
    print("\n=== save_new_skill + update_existing_skill roundtrip ===")
    let tmp_base = "/tmp/helen_skill_test_" + str(int(time()))
    // We can't easily redirect ./.helen/skills, so test the validation paths
    // and the update_existing_skill path check.
    // update_existing_skill rejects paths not starting with .helen/skills/
    let r = ChatSessionActor.update_existing_skill("/tmp/outside.helen", "addition")
    _assert_equal(r["status"], "error", "rejects path outside .helen/skills/")
    _assert(contains(str(r["reason"]), "skills"), "reason mentions skills")
}

