// ── patch_code_file ──────────────────────────────────────────

fn test_patch_code_file_roundtrip() {
    print("\n=== patch_code_file patches content ===")
    let tmp_path = "/tmp/helen_test_patch_" + str(int(time())) + ".helen"
    // Create initial file
    ChatSessionActor.save_code_file(tmp_path, "// hello\nmain { }\n")

    // Patch it
    let r = ChatSessionActor.patch_code_file(tmp_path, "// hello", "// goodbye")
    _assert(r["status"] == "patched", "status = patched (got: " + str(r["status"]) + ")")

    // Verify patch applied
    let content = read_file(tmp_path)
    _assert(contains(content, "goodbye"), "patch applied")
    _assert(!contains(content, "// hello"), "old content replaced")

    // 清理
    try { delete_file(tmp_path) } catch {}
}

fn test_patch_code_file_nonexistent() {
    print("\n=== patch_code_file on nonexistent file ===")
    let r = ChatSessionActor.patch_code_file("/tmp/nonexistent_xyz_123.helen", "old", "new")
    // patch_file on nonexistent file should error
    _assert(r["status"] == "error" || r["status"] == "patched", "returns error or patched status")
}

