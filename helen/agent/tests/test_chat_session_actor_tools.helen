// ── save_code_file 补充测试 ──────────────────────────────────

fn test_save_code_file_non_helen() {
    print("\n=== save_code_file with non-.helen file ===")
    let tmp_path = "/tmp/helen_test_nonhelen_" + str(int(time())) + ".txt"
    let r = ChatSessionActor.save_code_file(tmp_path, "hello world")
    _assert_equal(r["status"], "written", "status = written for non-.helen")
    // Non-.helen files skip the helen check, result is {"status": "written"} only
    _assert(len(str(r)) < 100, "result is small map (no check fields)")

    let content = read_file(tmp_path)
    _assert_equal(content, "hello world", "content matches for non-.helen")
    try { delete_file(tmp_path) } catch {}
}

fn test_save_code_file_empty_content() {
    print("\n=== save_code_file with empty content ===")
    let tmp_path = "/tmp/helen_test_empty_" + str(int(time())) + ".helen"
    let r = ChatSessionActor.save_code_file(tmp_path, "")
    _assert(r["status"] == "written", "status = written for empty content")
    try { delete_file(tmp_path) } catch {}
}

// ── update_existing_skill roundtrip ──────────────────────────

fn test_update_existing_skill_roundtrip() {
    print("\n=== update_existing_skill roundtrip ===")
    // update_existing_skill requires path to start with .helen/skills/ or ./.helen/skills/
    // Use CWD-relative path under .helen/skills/
    let skill_dir = "./.helen/skills/testcat/savetest_" + str(int(time()))
    mkdir_p(skill_dir)
    let skill_path = skill_dir + "/SKILL.md"
    write_file(skill_path, "# Test Skill\nOriginal content")

    let r = ChatSessionActor.update_existing_skill(skill_path, "Added content")
    _assert_equal(r["status"], "updated", "status = updated for valid path")
    _assert_equal(r["path"], skill_path, "path matches")

    let content = read_file(skill_path)
    _assert(contains(content, "Original content"), "original content preserved")
    _assert(contains(content, "Added content"), "addition appended")

    try { shell_exec("rm -rf " + skill_dir) } catch {}
}

// ── verify_after_change 补充测试 ─────────────────────────────

fn test_verify_after_change_nonexistent_files() {
    print("\n=== verify_after_change with nonexistent files ===")
    let r = ChatSessionActor.verify_after_change(
        "/tmp/nonexistent_verify_xyz.helen",
        "/tmp/nonexistent_test_xyz.helen"
    )
    // Valid path chars but files don't exist - shell commands will fail
    _assert(r["check_valid"] == true || r["check_valid"] == false, "returns boolean check_valid")
    _assert(r["test_passed"] == true || r["test_passed"] == false, "returns boolean test_passed")
    // check_valid should be false since file doesn't exist
    _assert_equal(r["check_valid"], false, "nonexistent file fails check")
}

// ── search_session_transcript 补充测试 ───────────────────────

fn test_search_session_transcript_specific_query() {
    print("\n=== search_session_transcript specific query ===")
    let r = ChatSessionActor.search_session_transcript("nonexistent_query_xyz", 3)
    _assert_equal(type(r), "str", "returns a string for specific query")
    // Result should be valid JSON
    _assert(len(r) >= 2, "returns valid JSON (at least [])")
}

