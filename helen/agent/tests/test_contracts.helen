// ═══════════════════════════════════════════════════════════════════
// 测试: contracts/contracts.helen
// ═══════════════════════════════════════════════════════════════════
//
// 运行: helen helen/agent/tests/test_contracts.helen
// 覆盖: 全部常量声明 (error codes, quality thresholds, CHAT_TOOLS)
//

import std.core.*
import std.str.*
import std.list.*
import "../contracts/contracts.helen"

fn _assert(condition: bool, test_name: str) {
    if condition {
        print("✓ " + test_name)
    } else {
        print("✗ FAIL: " + test_name)
    }
}

fn _assert_equal(actual: any, expected: any, test_name: str) {
    if str(actual) == str(expected) {
        print("✓ " + test_name)
    } else {
        print("✗ FAIL: " + test_name + " (expected '" + str(expected) + "', got '" + str(actual) + "')")
    }
}

// ── Error codes ──────────────────────────────────────────────

fn test_error_codes_are_integers() {
    print("\n=== error codes type ===")
    _assert(type(ERR_AGENT_FAILED) == "int", "ERR_AGENT_FAILED is int")
    _assert(type(ERR_CONTRACT_INVALID) == "int", "ERR_CONTRACT_INVALID is int")
    _assert(type(ERR_TEST_GENERATION_FAILED) == "int", "ERR_TEST_GENERATION_FAILED is int")
    _assert(type(ERR_IMPLEMENTATION_FAILED) == "int", "ERR_IMPLEMENTATION_FAILED is int")
    _assert(type(ERR_QUALITY_BELOW_THRESHOLD) == "int", "ERR_QUALITY_BELOW_THRESHOLD is int")
    _assert(type(ERR_SKILL_EVALUATION_FAILED) == "int", "ERR_SKILL_EVALUATION_FAILED is int")
    _assert(type(ERR_FILE_NOT_FOUND) == "int", "ERR_FILE_NOT_FOUND is int")
    _assert(type(ERR_PATCH_FAILED) == "int", "ERR_PATCH_FAILED is int")
}

fn test_error_codes_in_range() {
    print("\n=== error codes in 5000-5999 range ===")
    _assert(ERR_AGENT_FAILED >= 5000 && ERR_AGENT_FAILED < 6000, "ERR_AGENT_FAILED in range")
    _assert(ERR_CONTRACT_INVALID >= 5000 && ERR_CONTRACT_INVALID < 6000, "ERR_CONTRACT_INVALID in range")
    _assert(ERR_TEST_GENERATION_FAILED >= 5000 && ERR_TEST_GENERATION_FAILED < 6000, "ERR_TEST_GENERATION_FAILED in range")
    _assert(ERR_IMPLEMENTATION_FAILED >= 5000 && ERR_IMPLEMENTATION_FAILED < 6000, "ERR_IMPLEMENTATION_FAILED in range")
    _assert(ERR_QUALITY_BELOW_THRESHOLD >= 5000 && ERR_QUALITY_BELOW_THRESHOLD < 6000, "ERR_QUALITY_BELOW_THRESHOLD in range")
    _assert(ERR_SKILL_EVALUATION_FAILED >= 5000 && ERR_SKILL_EVALUATION_FAILED < 6000, "ERR_SKILL_EVALUATION_FAILED in range")
    _assert(ERR_FILE_NOT_FOUND >= 5000 && ERR_FILE_NOT_FOUND < 6000, "ERR_FILE_NOT_FOUND in range")
    _assert(ERR_PATCH_FAILED >= 5000 && ERR_PATCH_FAILED < 6000, "ERR_PATCH_FAILED in range")
}

fn test_error_codes_distinct() {
    print("\n=== error codes distinct ===")
    let codes = [
        ERR_AGENT_FAILED, ERR_CONTRACT_INVALID, ERR_TEST_GENERATION_FAILED,
        ERR_IMPLEMENTATION_FAILED, ERR_QUALITY_BELOW_THRESHOLD,
        ERR_SKILL_EVALUATION_FAILED, ERR_FILE_NOT_FOUND, ERR_PATCH_FAILED
    ]
    _assert_equal(len(codes), 8, "8 error codes defined")
    _assert_equal(len(unique(codes)), 8, "all error codes have distinct values")
}

fn test_specific_error_values() {
    print("\n=== specific error code values ===")
    _assert_equal(ERR_AGENT_FAILED, 5001, "ERR_AGENT_FAILED = 5001")
    _assert_equal(ERR_CONTRACT_INVALID, 5002, "ERR_CONTRACT_INVALID = 5002")
    _assert_equal(ERR_TEST_GENERATION_FAILED, 5003, "ERR_TEST_GENERATION_FAILED = 5003")
    _assert_equal(ERR_IMPLEMENTATION_FAILED, 5004, "ERR_IMPLEMENTATION_FAILED = 5004")
    _assert_equal(ERR_QUALITY_BELOW_THRESHOLD, 5005, "ERR_QUALITY_BELOW_THRESHOLD = 5005")
    _assert_equal(ERR_SKILL_EVALUATION_FAILED, 5006, "ERR_SKILL_EVALUATION_FAILED = 5006")
    _assert_equal(ERR_FILE_NOT_FOUND, 5007, "ERR_FILE_NOT_FOUND = 5007")
    _assert_equal(ERR_PATCH_FAILED, 5008, "ERR_PATCH_FAILED = 5008")
}

// ── Quality thresholds ───────────────────────────────────────

fn test_quality_thresholds() {
    print("\n=== quality thresholds ===")
    _assert(QUALITY_THRESHOLD > 0 && QUALITY_THRESHOLD <= 10, "QUALITY_THRESHOLD in (0, 10]")
    _assert(MIN_DIMENSION_SCORE > 0 && MIN_DIMENSION_SCORE <= 10, "MIN_DIMENSION_SCORE in (0, 10]")
    _assert(QUALITY_THRESHOLD >= MIN_DIMENSION_SCORE, "QUALITY_THRESHOLD >= MIN_DIMENSION_SCORE")
    _assert_equal(QUALITY_THRESHOLD, 7.5, "QUALITY_THRESHOLD = 7.5")
    _assert_equal(MIN_DIMENSION_SCORE, 6.0, "MIN_DIMENSION_SCORE = 6.0")
}

// ── CHAT_TOOLS list ──────────────────────────────────────────

fn test_chat_tools_is_list() {
    print("\n=== CHAT_TOOLS structure ===")
    _assert(type(CHAT_TOOLS) == "list", "CHAT_TOOLS is a list")
    _assert(len(CHAT_TOOLS) > 0, "CHAT_TOOLS is non-empty")
}

fn test_chat_tools_core() {
    print("\n=== CHAT_TOOLS core tools ===")
    _assert(contains(CHAT_TOOLS, "read_file"), "contains read_file")
    _assert(contains(CHAT_TOOLS, "write_file"), "contains write_file")
    _assert(contains(CHAT_TOOLS, "patch_file"), "contains patch_file")
    _assert(contains(CHAT_TOOLS, "shell_exec"), "contains shell_exec")
    _assert(contains(CHAT_TOOLS, "calculate"), "contains calculate")
}

fn test_chat_tools_web() {
    print("\n=== CHAT_TOOLS web tools ===")
    _assert(contains(CHAT_TOOLS, "web_search"), "contains web_search")
    _assert(contains(CHAT_TOOLS, "web_fetch"), "contains web_fetch")
}

fn test_chat_tools_skill() {
    print("\n=== CHAT_TOOLS skill tools ===")
    _assert(contains(CHAT_TOOLS, "load_skill"), "contains load_skill")
    _assert(contains(CHAT_TOOLS, "update_memory"), "contains update_memory")
    _assert(contains(CHAT_TOOLS, "update_user_preference"), "contains update_user_preference")
    _assert(contains(CHAT_TOOLS, "list_existing_skills"), "contains list_existing_skills")
    _assert(contains(CHAT_TOOLS, "read_skill_content"), "contains read_skill_content")
    _assert(contains(CHAT_TOOLS, "save_new_skill"), "contains save_new_skill")
    _assert(contains(CHAT_TOOLS, "update_existing_skill"), "contains update_existing_skill")
    _assert(contains(CHAT_TOOLS, "refresh_skill_index"), "contains refresh_skill_index")
}

fn test_chat_tools_quality() {
    print("\n=== CHAT_TOOLS quality tools ===")
    _assert(contains(CHAT_TOOLS, "run_helen_check"), "contains run_helen_check")
    _assert(contains(CHAT_TOOLS, "run_helen_tests"), "contains run_helen_tests")
    _assert(contains(CHAT_TOOLS, "get_scores"), "contains get_scores")
    _assert(contains(CHAT_TOOLS, "get_metrics"), "contains get_metrics")
    _assert(contains(CHAT_TOOLS, "verify_after_change"), "contains verify_after_change")
    _assert(contains(CHAT_TOOLS, "run_single_test"), "contains run_single_test")
}

fn test_chat_tools_debug() {
    print("\n=== CHAT_TOOLS debug tools ===")
    _assert(contains(CHAT_TOOLS, "emit_debug"), "contains emit_debug")
    _assert(contains(CHAT_TOOLS, "search_session_transcript"), "contains search_session_transcript")
    _assert(contains(CHAT_TOOLS, "get_context_stats"), "contains get_context_stats")
    _assert(contains(CHAT_TOOLS, "enable_tracing"), "contains enable_tracing")
    _assert(contains(CHAT_TOOLS, "get_execution_trace"), "contains get_execution_trace")
    _assert(contains(CHAT_TOOLS, "query_llm_log"), "contains query_llm_log")
    _assert(contains(CHAT_TOOLS, "query_last_error"), "contains query_last_error")
    _assert(contains(CHAT_TOOLS, "query_call_stack"), "contains query_call_stack")
}

fn test_chat_tools_hooks() {
    print("\n=== CHAT_TOOLS hooks ===")
    _assert(contains(CHAT_TOOLS, "save_code_file"), "contains save_code_file")
    _assert(contains(CHAT_TOOLS, "patch_code_file"), "contains patch_code_file")
    _assert(contains(CHAT_TOOLS, "pre_exit_check"), "contains pre_exit_check")
    _assert(contains(CHAT_TOOLS, "create_project_structure"), "contains create_project_structure")
}

fn test_chat_tools_no_duplicates() {
    print("\n=== CHAT_TOOLS uniqueness ===")
    _assert_equal(len(CHAT_TOOLS), len(unique(CHAT_TOOLS)), "no duplicate tools")
}

fn test_chat_tools_all_strings() {
    print("\n=== CHAT_TOOLS all strings ===")
    let all_strings = true
    for tool in CHAT_TOOLS {
        if type(tool) != "str" {
            all_strings = false
        }
    }
    _assert(all_strings, "all CHAT_TOOLS entries are strings")
}

// ── Run all tests ────────────────────────────────────────────

main {
    print("═══════════════════════════════════════════")
    print("  contracts/contracts.helen 测试")
    print("═══════════════════════════════════════════")

    test_error_codes_are_integers()
    test_error_codes_in_range()
    test_error_codes_distinct()
    test_specific_error_values()
    test_quality_thresholds()
    test_chat_tools_is_list()
    test_chat_tools_core()
    test_chat_tools_web()
    test_chat_tools_skill()
    test_chat_tools_quality()
    test_chat_tools_debug()
    test_chat_tools_hooks()
    test_chat_tools_no_duplicates()
