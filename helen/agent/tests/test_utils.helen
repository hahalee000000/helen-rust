// ═══════════════════════════════════════════════════════════════════
// 测试: utils.helen — validate_path 安全性 + ensure_python_path
// ═══════════════════════════════════════════════════════════════════
//
// 运行: helen tests/test_utils.helen
//

import std.core.*
import std.str.*
import std.system.*
import "../utils.helen"

fn _assert(condition: bool, test_name: str) {
    if condition {
        print("✓ " + test_name)
    } else {
        print("✗ FAIL: " + test_name)
    }
}

fn _assert_equal(actual: str, expected: str, test_name: str) {
    if actual == expected {
        print("✓ " + test_name)
    } else {
        print("✗ FAIL: " + test_name + " (expected '" + expected + "', got '" + actual + "')")
    }
}

// ── validate_path 测试 ────────────────────────────────────────

fn test_validate_path_normal() {
    print("\n=== validate_path: 正常路径 ===")
    _assert_equal(validate_path("hello.helen"), "hello.helen", "普通文件名")
    _assert_equal(validate_path("src/main.helen"), "src/main.helen", "带目录")
    _assert_equal(validate_path("src/sub/file.helen"), "src/sub/file.helen", "多级目录")
    _assert_equal(validate_path(".helen/skills/SKILL.md"), ".helen/skills/SKILL.md", "隐藏目录")
    _assert_equal(validate_path("my-file_v2.helen"), "my-file_v2.helen", "含 - 和 _")
    _assert_equal(validate_path("test123.helen"), "test123.helen", "含数字")
}

fn test_validate_path_injection() {
    print("\n=== validate_path: 注入防御 ===")
    _assert_equal(validate_path("file; rm -rf /"), "", "分号注入")
    _assert_equal(validate_path("file | cat /etc/passwd"), "", "管道注入")
    _assert_equal(validate_path("file && echo pwned"), "", "&& 注入")
    _assert_equal(validate_path("$(whoami)"), "", "命令替换 $()")
    _assert_equal(validate_path("file`whoami`"), "", "反引号注入")
    _assert_equal(validate_path("file > /dev/null"), "", "重定向 >")
    _assert_equal(validate_path("file < /etc/passwd"), "", "重定向 <")
    _assert_equal(validate_path("file\nrm -rf /"), "", "换行注入")
    _assert_equal(validate_path("file\\nrm"), "", "反斜杠")
    _assert_equal(validate_path(""), "", "空字符串")
    _assert_equal(validate_path("file with spaces"), "", "空格")
    _assert_equal(validate_path("file'quote"), "", "单引号")
    _assert_equal(validate_path("file\"quote"), "", "双引号")
}

fn test_validate_path_edge_cases() {
    print("\n=== validate_path: 边界用例 ===")
    _assert_equal(validate_path("/"), "/", "根目录")
    _assert_equal(validate_path("."), ".", "当前目录")
    _assert_equal(validate_path(".."), "..", "上级目录")
    _assert_equal(validate_path("a"), "a", "单字符")
    _assert_equal(validate_path("./src/../main.helen"), "./src/../main.helen", "含 .. 的路径")
}

// ── 环境工具函数 ─────────────────────────────────────────────

fn test_get_cwd() {
    print("\n=== get_cwd ===")
    let cwd = get_cwd()
    _assert(len(cwd) > 0, "get_cwd 返回非空字符串")
    // 应该是绝对路径 (starts with "/" on Unix or "X:\" on Windows)
    let first_char = substring(cwd, 0, 1)
    let is_absolute = first_char == "/" || (len(cwd) > 2 && substring(cwd, 1, 2) == ":")
    _assert(is_absolute, "cwd 是绝对路径")
}

fn test_get_home() {
    print("\n=== get_home ===")
    let home = get_home()
    _assert(len(home) > 0, "get_home 返回非空字符串")
    // 应该包含 "home" 或在 Windows 上是驱动器
    _assert(contains(home, "home") || contains(home, ":\\") || contains(home, "Users"), "home 包含预期路径段")
}

fn test_detect_helen_version() {
    print("\n=== detect_helen_version ===")
    let ver = detect_helen_version()
    _assert(len(ver) > 0, "detect_helen_version 返回非空")
    // 应该是类似 "1.40.0" 格式
    _assert(contains(ver, ".") || ver == "1.20", "版本号包含 . 或是默认 1.20")
}

fn test_safe_git_branch() {
    print("\n=== safe_git_branch ===")
    let b = safe_git_branch()
    _assert(len(b) > 0, "safe_git_branch 返回非空")
    _assert(b != "", "分支名不为空")
}

fn test_check_git_dirty() {
    print("\n=== check_git_dirty ===")
    let dirty = check_git_dirty()
    _assert(dirty == "true" || dirty == "false" || dirty == "unknown", "check_git_dirty 返回有效值: " + dirty)
}

fn test_ensure_python_path() {
    print("\n=== ensure_python_path ===")
    // 调用不应崩溃
    try {
        ensure_python_path()
        let pp = env_get("PYTHONPATH", "")
        // PYTHONPATH 现在应该包含 cwd
        let cwd = get_cwd()
        _assert(contains(pp, cwd), "PYTHONPATH 包含 cwd")
        _assert(true, "ensure_python_path 不崩溃")
    } catch {
        _assert(false, "ensure_python_path 不应抛出")
    }
}

// ── 主测试 ──────────────────────────────────────────────────

main {
    print("╔═══════════════════════════════════════════════════════════╗")
    print("║      utils.helen 测试                                    ║")
    print("╚═══════════════════════════════════════════════════════════╝")

    test_validate_path_normal()
    test_validate_path_injection()
    test_validate_path_edge_cases()
    test_get_cwd()
    test_get_home()
    test_detect_helen_version()
    test_safe_git_branch()
    test_check_git_dirty()
    test_ensure_python_path()

    print("\n╔═══════════════════════════════════════════════════════════╗")
    print("║      utils.helen 测试完成                                ║")
    print("╚═══════════════════════════════════════════════════════════╝")
}
