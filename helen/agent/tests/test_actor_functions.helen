// 测试: chat_session_actor.helen 的工具函数
// v1.0: 合并 specialist agents 后的工具函数测试

import std.context.*
import std.core.*
import std.str.*
import "../chat_session_actor.helen"
import "../commands.helen"
import "../output.helen"

fn _assert(condition: bool, test_name: str) {
    if condition {
        print("✓ " + test_name)
    } else {
        print("✗ FAIL: " + test_name)
    }
}

fn _assert_eq(actual: str, expected: str, test_name: str) {
    if actual == expected {
        print("✓ " + test_name)
    } else {
        print("✗ FAIL: " + test_name + " (期望 '" + expected + "', 实际 '" + actual + "')")
    }
}

fn _assert_contains(text: str, sub: str, test_name: str) {
    if contains(text, sub) {
        print("✓ " + test_name)
    } else {
        print("✗ FAIL: " + test_name + " (未包含 '" + sub + "')")
    }
}

main {
    print("\n=== parse_command (actor 命令) ===")
    let cmd1 = parse_command("/working-memory")
    _assert(cmd1["is_command"] == true, "/working-memory 是命令")
    _assert(cmd1["command"] == "working-memory", "命令名正确")

    let cmd2 = parse_command("/clear-session abc123")
    _assert(cmd2["is_command"] == true, "/clear-session 是命令")
    _assert(cmd2["command"] == "clear-session", "命令名正确")
    _assert(len(cmd2["args"]) == 1, "有 1 个参数")
    _assert(cmd2["args"][0] == "abc123", "参数值正确")

    let cmd3 = parse_command("普通消息")
    _assert(cmd3["is_command"] == false, "普通消息不是命令")

    print("\n=== working_memory_get (无 LLM 调用时) ===")
    try {
        let result = working_memory_get()
        _assert(result["status"] == "ok" || result["status"] == "error", "working_memory_get 返回有效状态")
        print("  status: " + result["status"])
    } catch RuntimeError err {
        print("✓ working_memory_get 抛 RuntimeError (预期 - 无 agent context): " + err.message)
    } catch {
        print("✓ working_memory_get 抛异常 (预期 - 无 agent context)")
    }

    print("\n=== 全部测试完成 ===")
}