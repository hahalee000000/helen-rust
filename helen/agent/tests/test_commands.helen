// ═══════════════════════════════════════════════════════════════════
// 测试: commands.helen — 命令解析 + 命令执行
// ═══════════════════════════════════════════════════════════════════
//
// 运行: helen tests/test_commands.helen
//

import std.core.*
import "../commands.helen"
import "../output.helen"

fn _assert(condition: bool, test_name: str) {
    if condition {
        print("✓ " + test_name)
    } else {
        print("✗ FAIL: " + test_name)
    }
}

fn _assert_equal(actual: str, expected: str, test_name: str) {
    if actual == expected {
        print("✓ " + test_name)
    } else {
        print("✗ FAIL: " + test_name + " (expected '" + expected + "', got '" + actual + "')")
    }
}

// ── parse_command 测试 ────────────────────────────────────────

fn test_parse_command_basic() {
    print("\n=== parse_command: 基本解析 ===")

    let cmd1 = parse_command("/help")
    _assert(cmd1["is_command"] == true, "/help 是命令")
    _assert_equal(cmd1["command"], "help", "/help 命令名")
    _assert(len(cmd1["args"]) == 0, "/help 无参数")

    let cmd2 = parse_command("/mode minimal")
    _assert(cmd2["is_command"] == true, "/mode minimal 是命令")
    _assert_equal(cmd2["command"], "mode", "/mode 命令名")
    _assert(len(cmd2["args"]) == 1, "/mode minimal 有 1 个参数")
    _assert_equal(cmd2["args"][0], "minimal", "/mode 参数是 minimal")

    let cmd3 = parse_command("/pin abc-123-def")
    _assert(cmd3["is_command"] == true, "/pin 是命令")
    _assert_equal(cmd3["command"], "pin", "/pin 命令名")
    _assert_equal(cmd3["args"][0], "abc-123-def", "/pin 参数是 UUID")

    let cmd4 = parse_command("/search hello world")
    _assert(cmd4["is_command"] == true, "/search 是命令")
    _assert(len(cmd4["args"]) == 2, "/search 有 2 个参数")
    _assert_equal(cmd4["args"][0], "hello", "/search 第 1 参数")
    _assert_equal(cmd4["args"][1], "world", "/search 第 2 参数")
}

fn test_parse_command_not_command() {
    print("\n=== parse_command: 非命令输入 ===")

    let cmd1 = parse_command("hello world")
    _assert(cmd1["is_command"] == false, "普通文本不是命令")

    let cmd2 = parse_command("")
    _assert(cmd2["is_command"] == false, "空字符串不是命令")

    let cmd3 = parse_command("简洁")
    _assert(cmd3["is_command"] == false, "旧式命令（无 /）不是斜杠命令")
}

fn test_parse_command_edge_cases() {
    print("\n=== parse_command: 边界用例 ===")

    let cmd1 = parse_command("/")
    _assert(cmd1["is_command"] == true, "/ 是命令（空命令名）")
    _assert_equal(cmd1["command"], "", "/ 的命令名为空")

    let cmd2 = parse_command("/help  ")
    _assert(cmd2["is_command"] == true, "/help  是命令")
    _assert(len(cmd2["args"]) == 0, "尾部空格不产生多余参数")

    let cmd3 = parse_command("/quit")
    _assert(cmd3["is_command"] == true, "/quit 是命令")
    _assert_equal(cmd3["command"], "quit", "/quit 命令名")

    let cmd4 = parse_command("/exit")
    _assert(cmd4["is_command"] == true, "/exit 是命令")
    _assert_equal(cmd4["command"], "exit", "/exit 命令名")
}

// ── 边界用例测试（全角、空格、Unicode、超长输入）─────────────

fn test_edge_cases() {
    print("\n=== parse_command: 边界用例 ===")

    // 全角斜杠（U+FF0F）归一化
    let cmd1 = parse_command("／help")
    _assert(cmd1["is_command"] == true, "全角斜杠 ／help 是命令")
    _assert_equal(cmd1["command"], "help", "全角斜杠命令名正确")

    // 前后空格
    let cmd2 = parse_command("  /help  ")
    _assert(cmd2["is_command"] == true, "前后空格的 /help 是命令")
    _assert_equal(cmd2["command"], "help", "去空格后命令名正确")

    // 多个参数
    let cmd3 = parse_command("/search hello world foo bar")
    _assert(len(cmd3["args"]) == 4, "4 个参数正确解析")
    _assert_equal(cmd3["args"][3], "bar", "第 4 参数正确")

    // 只有斜杠
    let cmd4 = parse_command("/")
    _assert(cmd4["is_command"] == true, "单独 / 是命令")
    _assert_equal(cmd4["command"], "", "单独 / 命令名为空")

    // 空字符串
    let cmd5 = parse_command("")
    _assert(cmd5["is_command"] == false, "空字符串不是命令")

    // 纯空白
    let cmd6 = parse_command("   ")
    _assert(cmd6["is_command"] == false, "纯空白不是命令")

    // 中文命令（非斜杠开头）
    let cmd7 = parse_command("简洁")
    _assert(cmd7["is_command"] == false, "中文旧式命令不是斜杠命令")

    // 全角斜杠 + 参数
    let cmd8 = parse_command("／mode minimal")
    _assert(cmd8["is_command"] == true, "全角斜杠带参数是命令")
    _assert_equal(cmd8["command"], "mode", "全角命令名正确")
    _assert_equal(cmd8["args"][0], "minimal", "全角参数正确")
}

// ── 命令执行测试（仅验证不崩溃） ────────────────────────────

fn test_command_execution() {
    print("\n=== 命令执行（验证不崩溃）===")
    init_output()
    set_output_level(OUTPUT_MINIMAL)

    // /help 应该成功执行
    execute_command(parse_command("/help"))
    print("✓ /help 执行成功")

    // /version 应该成功执行
    execute_command(parse_command("/version"))
    print("✓ /version 执行成功")

    // /memory 应该成功执行
    execute_command(parse_command("/memory"))
    print("✓ /memory 执行成功")

    // /stats 应该成功执行
    execute_command(parse_command("/stats"))
    print("✓ /stats 执行成功")

    // 未知命令应该优雅处理
    execute_command(parse_command("/unknown_cmd"))
    print("✓ 未知命令优雅处理")
}

// ── 主测试 ──────────────────────────────────────────────────

main {
    print("╔═══════════════════════════════════════════════════════════╗")
    print("║      commands.helen 测试                                 ║")
    print("╚═══════════════════════════════════════════════════════════╝")

    test_parse_command_basic()
    test_parse_command_not_command()
    test_parse_command_edge_cases()
    test_edge_cases()
    test_command_execution()

    print("\n╔═══════════════════════════════════════════════════════════╗")
    print("║      commands.helen 测试完成                             ║")
    print("╚═══════════════════════════════════════════════════════════╝")
}
