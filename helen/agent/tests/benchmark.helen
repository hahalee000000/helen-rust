// ═══════════════════════════════════════════════════════════════════
// HelenAgent 性能基准测试
// ═══════════════════════════════════════════════════════════════════
//
// 测量 helenagent 核心路径的 in-process 性能（不涉及 LLM 调用）：
// - UI 事件队列 emit+drain 吞吐
// - 输出模式切换 round-trip
// - JSON 序列化/反序列化
// - 跨模块函数调用开销
//
// 运行：helen tests/benchmark.helen
//

import std.core.*
import std.data.*
import std.str.*
import std.time.*
import "../ui_event_queue.helen"
import "../output.helen"

// ── 计时辅助 ────────────────────────────────────────────────────

/** 获取当前时间戳（秒，浮点）— 跨平台：用 stdlib time() */
fn _now(): float {
    return time()  // time() 返回 float（秒）
}

/** 格式化耗时（毫秒） */
fn _fmt_ms(elapsed: float): str {
    let ms = elapsed * 1000.0
    return format_float(ms, 2)
}

// ── 基准测试用例 ────────────────────────────────────────────────

/** 基准 1：UI 事件队列 emit + drain 吞吐 */
fn _bench_event_queue(n: int) {
    flush_ui_events()
    ui_clear_abort()

    let t0 = _now()
    let i = 0
    while i < n {
        ui_emit_llm_chunk("Bench", "chunk-" + str(i))
        i = i + 1
    }
    let events = flush_ui_events()
    let t1 = _now()

    let elapsed = t1 - t0
    let throughput = float(n) / elapsed
    print("事件队列 emit+" + str(n) + " drain: " + _fmt_ms(elapsed) + " ms (" + format_float(throughput, 0) + " ops/s)\n")
    print("  入队数: " + str(len(events)) + "\n")
}

/** 基准 2：输出模式切换 round-trip */
fn _bench_output_mode_switch(n: int) {
    let t0 = _now()
    let i = 0
    while i < n {
        set_output_mode("normal")
        get_output_mode()
        set_output_mode("verbose")
        get_output_mode()
        set_output_mode("minimal")
        get_output_mode()
        i = i + 1
    }
    let t1 = _now()
    let elapsed = t1 - t0
    let throughput = float(n * 3) / elapsed
    print("输出模式切换 x" + str(n) + " (3 轮/set): " + _fmt_ms(elapsed) + " ms (" + format_float(throughput, 0) + " ops/s)\n")
    set_output_mode("minimal")
}

/** 基准 3：JSON 序列化/反序列化 */
fn _bench_json(n: int) {
    let inner = {"a": "b"}
    let data = {"name": "test", "values": [1, 2, 3, 4, 5], "nested": inner}
    let t0 = _now()
    let i = 0
    while i < n {
        let s = json_stringify(data)
        let parsed = json_parse(s)
        i = i + 1
    }
    let t1 = _now()
    let elapsed = t1 - t0
    let throughput = float(n) / elapsed
    print("json_stringify+parse x" + str(n) + ": " + _fmt_ms(elapsed) + " ms (" + format_float(throughput, 0) + " ops/s)\n")
}

/** 基准 4：跨模块函数调用开销（vs 同模块） */
fn _bench_cross_module_call(n: int) {
    // 跨模块调用：调用 ui_event_queue.helen 的函数
    let t0 = _now()
    let i = 0
    while i < n {
        ui_check_aborted()
        i = i + 1
    }
    let t1 = _now()
    let elapsed_cross = t1 - t0

    // 同模块调用：调用本文件的 _now（纯计算对照）
    let t2 = _now()
    let j = 0
    while j < n {
        ui_queue_size()
        j = j + 1
    }
    let t3 = _now()
    let elapsed_same = t3 - t2

    print("跨模块调用 ui_check_aborted x" + str(n) + ": " + _fmt_ms(elapsed_cross) + " ms\n")
    print("跨模块调用 ui_queue_size    x" + str(n) + ": " + _fmt_ms(elapsed_same) + " ms\n")
}

// ── 主函数 ──────────────────────────────────────────────────────

main {
    print("╔═══════════════════════════════════════════════════════════╗\n")
    print("║      HelenAgent 性能基准测试                              ║\n")
    print("╚═══════════════════════════════════════════════════════════╝\n")
    print("（不涉及 LLM 调用，测量纯 helenagent 代码路径）\n\n")

    print("── 基准 1：UI 事件队列 ──\n")
    _bench_event_queue(500)

    print("\n── 基准 2：输出模式切换 ──\n")
    _bench_output_mode_switch(2000)

    print("\n── 基准 3：JSON 序列化 ──\n")
    _bench_json(2000)

    print("\n── 基准 4：跨模块调用开销 ──\n")
    _bench_cross_module_call(5000)

    print("\n╔═══════════════════════════════════════════════════════════╗\n")
    print("║      基准测试完成                                         ║\n")
    print("╚═══════════════════════════════════════════════════════════╝\n")
}
