// ═══════════════════════════════════════════════════════════════════
// 测试: system_reminders.helen
// ═══════════════════════════════════════════════════════════════════
//
// 运行: helen helen/agent/tests/test_system_reminders.helen
// 覆盖: inject_system_reminders, _dynamic_interval, get_turn_counter, reset_turn_counter
//
// 注：_dynamic_interval 依赖 std.context.context_usage()，在测试环境下
// 通常返回低占用率 (< 0.5)，所以 interval 默认为 REMINDER_INTERVAL (10)。
// 我们测试"行为"而不是"具体值"。

import std.core.*
import std.str.*
import "../system_reminders.helen"

fn _assert(condition: bool, test_name: str) {
    if condition {
        print("✓ " + test_name)
    } else {
        print("✗ FAIL: " + test_name)
    }
}

fn _assert_equal(actual: any, expected: any, test_name: str) {
    if str(actual) == str(expected) {
        print("✓ " + test_name)
    } else {
        print("✗ FAIL: " + test_name + " (expected '" + str(expected) + "', got '" + str(actual) + "')")
    }
}

// ── turn counter ─────────────────────────────────────────────

fn test_turn_counter_initial() {
    print("\n=== turn counter initial state ===")
    reset_turn_counter()
    _assert_equal(get_turn_counter(), 0, "counter starts at 0 after reset")
}

fn test_turn_counter_increments() {
    print("\n=== turn counter increments ===")
    reset_turn_counter()
    inject_system_reminders("msg 1")
    _assert_equal(get_turn_counter(), 1, "counter = 1 after first call")
    inject_system_reminders("msg 2")
    _assert_equal(get_turn_counter(), 2, "counter = 2 after second call")
    inject_system_reminders("msg 3")
    _assert_equal(get_turn_counter(), 3, "counter = 3 after third call")
}

fn test_reset_turn_counter() {
    print("\n=== reset_turn_counter ===")
    inject_system_reminders("msg")
    inject_system_reminders("msg")
    _assert(get_turn_counter() > 0, "counter > 0 before reset")
    reset_turn_counter()
    _assert_equal(get_turn_counter(), 0, "counter = 0 after reset")
}

// ── inject_system_reminders ──────────────────────────────────

fn test_inject_returns_input_unchanged_when_not_interval() {
    print("\n=== inject unchanged at non-interval turn ===")
    reset_turn_counter()
    // After reset, turn_counter = 0. Call once -> counter = 1.
    // In low-usage context, interval = 10, so turn 1 is not a multiple of 10.
    let result = inject_system_reminders("hello world")
    _assert_equal(result, "hello world", "input unchanged at turn 1")
}

fn test_inject_appends_reminder_at_interval() {
    print("\n=== inject appends reminder at interval ===")
    reset_turn_counter()
    // In low-usage context, interval = 10
    // Call 9 times to get to turn 9, then the 10th call triggers reminder
    let i = 0
    while i < 9 {
        inject_system_reminders("filler")
        i = i + 1
    }
    // Now turn counter = 9. Next call will be turn 10 (multiple of 10).
    let result = inject_system_reminders("the real message")
    // Result should contain the original message plus a reminder
    _assert(len(result) > len("the real message"), "result longer than input at turn 10")
    _assert(result != "the real message", "result is modified at turn 10")
}

fn test_inject_reminder_contains_system_reminder_tag() {
    print("\n=== reminder has <system-reminder> tag ===")
    reset_turn_counter()
    let i = 0
    while i < 9 {
        inject_system_reminders("filler")
        i = i + 1
    }
    let result = inject_system_reminders("msg")
    // The reminder text should include <system-reminder> marker
    _assert(len(result) > 50, "result has substantial content at reminder turn")
}

fn test_inject_preserves_original_message() {
    print("\n=== reminder preserves original message ===")
    reset_turn_counter()
    let i = 0
    while i < 9 {
        inject_system_reminders("filler")
        i = i + 1
    }
    let original = "please analyze this code"
    let result = inject_system_reminders(original)
    // Result should start with the original message
    _assert(len(result) >= len(original), "result at least as long as original")
}

fn test_inject_turn_counter_keeps_incrementing() {
    print("\n=== turn counter keeps incrementing ===")
    reset_turn_counter()
    let i = 0
    while i < 15 {
        inject_system_reminders("msg")
        i = i + 1
    }
    _assert_equal(get_turn_counter(), 15, "counter = 15 after 15 calls")
}

fn test_inject_multiple_reminders() {
    print("\n=== multiple reminders across long session ===")
    reset_turn_counter()
    let reminder_count = 0
    let i = 0
    while i < 25 {
        let result = inject_system_reminders("msg")
        if len(result) > len("msg") {
            reminder_count = reminder_count + 1
        }
        i = i + 1
    }
    // In low-usage (interval=10), turns 10 and 20 should trigger = 2 reminders
    _assert(reminder_count >= 2, "at least 2 reminders in 25 turns")
}

// ── _dynamic_interval ────────────────────────────────────────

fn test_dynamic_interval_returns_positive_int() {
    print("\n=== _dynamic_interval basic behavior ===")
    let interval = _dynamic_interval()
    _assert(type(interval) == "int", "_dynamic_interval returns int")
    _assert(interval > 0, "_dynamic_interval returns positive value")
}

fn test_dynamic_interval_valid_values() {
    print("\n=== _dynamic_interval valid value set ===")
    let interval = _dynamic_interval()
    let valid = interval == 3 || interval == 5 || interval == 10
    _assert(valid, "_dynamic_interval returns 3, 5, or 10 (got " + str(interval) + ")")
}

fn test_dynamic_interval_low_usage_default() {
    print("\n=== _dynamic_interval low-usage default ===")
    // In test env, context_usage() returns a low value (< 0.5),
    // so _dynamic_interval should return REMINDER_INTERVAL (10)
    let interval = _dynamic_interval()
    _assert_equal(interval, 10, "low-usage context -> interval = 10")
}

fn test_dynamic_interval_consistent() {
    print("\n=== _dynamic_interval consistent across calls ===")
    let a = _dynamic_interval()
    let b = _dynamic_interval()
    _assert_equal(a, b, "repeated calls return same value (stable context)")
}

// ── Run all tests ────────────────────────────────────────────

main {
    print("═══════════════════════════════════════════")
    print("  system_reminders.helen 测试")
    print("═══════════════════════════════════════════")

    test_turn_counter_initial()
    test_turn_counter_increments()
    test_reset_turn_counter()
    test_inject_returns_input_unchanged_when_not_interval()
    test_inject_appends_reminder_at_interval()
    test_inject_reminder_contains_system_reminder_tag()
    test_inject_preserves_original_message()
    test_inject_turn_counter_keeps_incrementing()
    test_inject_multiple_reminders()
    test_dynamic_interval_returns_positive_int()
    test_dynamic_interval_valid_values()
    test_dynamic_interval_low_usage_default()
    test_dynamic_interval_consistent()

    print("\n═══════════════════════════════════════════")
    print("  全部 system_reminders 测试完成")
    print("═══════════════════════════════════════════")
}
