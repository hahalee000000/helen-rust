// 质量评估脚本 — 检查核心 agent 文件质量
// v1.0: specialist agents 已合并到 chat_session_actor.helen

import std.core.*
import std.path.*
import std.quality.*
main {
    let files = ["chat_session_actor.helen"]

    for file in files {
        if path_exists(file) {
            let content = read_file(file)
            let scores = quality_score(content, file)
            let security = check_security(content)

            print("=== " + file + " ===")
            print(scores)
            print("\nSecurity:")
            print(security)
            print("\n")
        }
    }
}
