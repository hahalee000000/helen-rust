// ── chat_llm_chunk / chat_llm_complete ────────────────────

fn test_chat_llm_chunk() {
    print("\n=== chat_llm_chunk ===")
    try {
        reset_llm_output_state()
        chat_llm_chunk("hello ")
        chat_llm_chunk("world")
        _assert(true, "chat_llm_chunk ok")
        _assert_equal(LLMStreamState.get_chunk_count(), 2, "chunk count = 2")
        _assert_equal(LLMStreamState.get_buffer(), "hello world", "buffer accumulated")
    } catch {
        _assert(false, "chat_llm_chunk should not crash")
    }
    reset_llm_output_state()
}

fn test_chat_llm_complete() {
    print("\n=== chat_llm_complete ===")
    try {
        reset_llm_output_state()
        chat_llm_complete()
        _assert(true, "chat_llm_complete (no chunks) ok")
    } catch {
        _assert(false, "chat_llm_complete should not crash")
    }
    try {
        LLMStreamState.append_chunk("test")
        LLMStreamState.increment_chunk_count()
        chat_llm_complete()
        _assert(true, "chat_llm_complete (with chunks) ok")
    } catch {
        _assert(false, "chat_llm_complete with chunks should not crash")
    }
}

