// ═══════════════════════════════════════════════════════════════════
// 测试: Web UI 命令响应（验证所有 _cmd_xxx_response 返回格式化文本）
// ═══════════════════════════════════════════════════════════════════
//
// 运行: helen tests/test_webui_commands.helen
//
// 此测试确保 commands.helen 的命令函数在 Web UI 路径下能正确返回
// 格式化文本（而非依赖 stdout/UIEventQueue 副作用）。
//

import std.core.*
import std.str.*
import "../commands.helen"
import "../output.helen"
import "../context_manager.helen"
import "../lang.helen"

fn _assert(condition: bool, test_name: str) {
    if condition {
        print("✓ " + test_name)
    } else {
        print("✗ FAIL: " + test_name)
    }
}

fn _assert_contains(text: str, sub: str, test_name: str) {
    if contains(text, sub) {
        print("✓ " + test_name)
    } else {
        print("✗ FAIL: " + test_name + " (未在响应中找到 '" + sub + "')")
        // 截断显示前 100 字符帮助调试
        let preview = text
        if len(preview) > 100 {
            preview = substring(text, 0, 100) + "..."
        }
        print("  实际响应: " + preview)
    }
}

fn _assert_not_empty(text: str, test_name: str) {
    if text != "" && len(text) > 0 {
        print("✓ " + test_name)
    } else {
        print("✗ FAIL: " + test_name + " (响应为空)")
    }
}

// ── /help 响应测试 ───────────────────────────────────────────

fn test_help_response() {
    print("\n=== /help 响应测试 ===")

    let response = execute_command(parse_command("/help"))
    _assert_not_empty(response, "/help 返回非空响应")

    // 验证包含所有命令
    _assert_contains(response, "/help", "帮助包含 /help")
    _assert_contains(response, "/clear", "帮助包含 /clear")
    _assert_contains(response, "/compress", "帮助包含 /compress")
    _assert_contains(response, "/context", "帮助包含 /context")
    _assert_contains(response, "/stats", "帮助包含 /stats")
    _assert_contains(response, "/memory", "帮助包含 /memory")
    _assert_contains(response, "/version", "帮助包含 /version")
    _assert_contains(response, "/session", "帮助包含 /session")
    _assert_contains(response, "/pin", "帮助包含 /pin")
    _assert_contains(response, "/unpin", "帮助包含 /unpin")
    _assert_contains(response, "/search", "帮助包含 /search")
    _assert_contains(response, "/mode", "帮助包含 /mode")

    // 验证是 Markdown 表格格式
    _assert_contains(response, "|", "帮助包含表格分隔符")
}

// ── /clear 响应测试 ──────────────────────────────────────────

fn test_clear_response() {
    print("\n=== /clear 响应测试 ===")

    let response = execute_command(parse_command("/clear"))
    _assert_not_empty(response, "/clear 返回非空响应")
    _assert_contains(response, _t("cleared", "清空"), "/clear 包含 '清空/cleared'")
}

// ── /compress 响应测试 ───────────────────────────────────────

fn test_compress_response() {
    print("\n=== /compress 响应测试 ===")

    let response = execute_command(parse_command("/compress"))
    _assert_not_empty(response, "/compress 返回非空响应")
    _assert_contains(response, _t("compress", "压缩"), "/compress 包含 '压缩/compress'")
}

// ── /mode 响应测试 ──────────────────────────────────────────

fn test_mode_response() {
    print("\n=== /mode 响应测试 ===")

    // /mode 无参数 → 显示当前模式
    let response = execute_command(parse_command("/mode"))
    _assert_not_empty(response, "/mode 无参数返回非空")
    _assert_contains(response, "minimal", "模式列表包含 minimal")

    // /mode minimal → 切换成功
    let response2 = execute_command(parse_command("/mode minimal"))
    _assert_contains(response2, "minimal", "切换到 minimal 成功")

    // /mode unknown → 错误提示
    let response3 = execute_command(parse_command("/mode unknown_mode"))
    _assert_contains(response3, _t("Unknown", "未知"), "未知模式提示错误")
}

// ── /stats 响应测试 ─────────────────────────────────────────

fn test_stats_response() {
    print("\n=== /stats 响应测试 ===")

    let response = execute_command(parse_command("/stats"))
    _assert_not_empty(response, "/stats 返回非空响应")
    _assert_contains(response, _t("Statistics", "统计"), "/stats 包含 '统计/Statistics'")
    _assert_contains(response, "Helen", "/stats 包含 Helen 版本")
}

