// ── /pin, /unpin 响应测试 ──────────────────────────────────

fn test_pin_unpin_response() {
    print("\n=== /pin, /unpin 响应测试 ===")

    // /pin 无参数 → 显示已钉住消息
    let response = execute_command(parse_command("/pin"))
    _assert_not_empty(response, "/pin 无参数返回非空")

    // /unpin 无参数 → 显示已钉住消息
    let response2 = execute_command(parse_command("/unpin"))
    _assert_not_empty(response2, "/unpin 无参数返回非空")

    // /pin fake-uuid → 钉住失败（消息不存在）
    let response3 = execute_command(parse_command("/pin fake-uuid-12345"))
    _assert_not_empty(response3, "/pin fake-uuid 返回非空")
}

// ── /search 响应测试 ────────────────────────────────────────

fn test_search_response() {
    print("\n=== /search 响应测试 ===")

    // /search 无参数 → 显示用法
    let response = execute_command(parse_command("/search"))
    _assert_not_empty(response, "/search 无参数返回非空")
    _assert_contains(response, _t("Usage", "用法"), "/search 显示用法")

    // /search hello → 搜索（可能没结果）
    let response2 = execute_command(parse_command("/search hello"))
    _assert_not_empty(response2, "/search hello 返回非空")
}

// ── 未知命令响应测试 ────────────────────────────────────────

fn test_unknown_command_response() {
    print("\n=== 未知命令响应测试 ===")

    let response = execute_command(parse_command("/nonexistent"))
    _assert_not_empty(response, "未知命令返回非空")
    _assert_contains(response, _t("Unknown", "未知"), "未知命令包含 '未知/Unknown'")
    _assert_contains(response, "/help", "未知命令建议查看帮助")
}

// ── 主测试 ──────────────────────────────────────────────────

main {
    print("╔═══════════════════════════════════════════════════════════╗")
    print("║      Web UI 命令响应测试                                 ║")
    print("╚═══════════════════════════════════════════════════════════╝")

    init_output()
    set_output_level(OUTPUT_MINIMAL)
    ContextManager.init()

    test_help_response()
    test_clear_response()
    test_compress_response()
    test_mode_response()
    test_stats_response()
    test_memory_response()
    test_context_response()
    test_version_response()
    test_session_response()
    test_pin_unpin_response()
    test_search_response()
    test_unknown_command_response()

    print("\n╔═══════════════════════════════════════════════════════════╗")
    print("║      Web UI 命令响应测试完成                             ║")
    print("╚═══════════════════════════════════════════════════════════╝")
}
