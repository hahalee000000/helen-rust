// ═══════════════════════════════════════════════════════════════════
// 测试: session_stats.helen
// ═══════════════════════════════════════════════════════════════════
//
// 运行: helen helen/agent/tests/test_session_stats.helen
// 覆盖: 全部 9 个 SessionStats 方法
//

import std.core.*
import std.str.*
import std.time.*
import "../session_stats.helen"

fn _assert(condition: bool, test_name: str) {
    if condition {
        print("✓ " + test_name)
    } else {
        print("✗ FAIL: " + test_name)
    }
}

fn _assert_equal(actual: any, expected: any, test_name: str) {
    if str(actual) == str(expected) {
        print("✓ " + test_name)
    } else {
        print("✗ FAIL: " + test_name + " (expected '" + str(expected) + "', got '" + str(actual) + "')")
    }
}

// ── init ─────────────────────────────────────────────────────

fn test_init_sets_start_time() {
    print("\n=== init sets start_time ===")
    SessionStats.init()
    let stats = SessionStats.get_stats()
    _assert(stats["start_time"] != 0, "start_time is set after init")
}

fn test_init_idempotent() {
    print("\n=== init is idempotent ===")
    SessionStats.init()
    let stats1 = SessionStats.get_stats()
    let t1 = stats1["start_time"]
    SessionStats.init()
    let stats2 = SessionStats.get_stats()
    let t2 = stats2["start_time"]
    _assert_equal(t1, t2, "start_time unchanged on second init")
}

// ── increment_turns ──────────────────────────────────────────

fn test_increment_turns() {
    print("\n=== increment_turns ===")
    let before = SessionStats.get_stats()["conversation_turns"]
    SessionStats.increment_turns()
    let after = SessionStats.get_stats()["conversation_turns"]
    _assert_equal(after, before + 1, "conversation_turns incremented by 1")
}

fn test_increment_turns_multiple() {
    print("\n=== increment_turns multiple ===")
    SessionStats.increment_turns()
    SessionStats.increment_turns()
    SessionStats.increment_turns()
    let turns = SessionStats.get_stats()["conversation_turns"]
    _assert(turns >= 3, "turns at least 3 after 3 calls")
}

// ── increment_agent_calls ────────────────────────────────────

fn test_increment_agent_calls() {
    print("\n=== increment_agent_calls ===")
    let before = SessionStats.get_stats()["agent_calls"]
    SessionStats.increment_agent_calls()
    let after = SessionStats.get_stats()["agent_calls"]
    _assert_equal(after, before + 1, "agent_calls incremented by 1")
}

// ── add_tokens ───────────────────────────────────────────────

fn test_add_tokens() {
    print("\n=== add_tokens ===")
    let before = SessionStats.get_stats()["total_tokens_estimated"]
    SessionStats.add_tokens(100)
    let after = SessionStats.get_stats()["total_tokens_estimated"]
    _assert_equal(after, before + 100, "tokens added correctly")
}

fn test_add_tokens_zero() {
    print("\n=== add_tokens(0) is no-op ===")
    let before = SessionStats.get_stats()["total_tokens_estimated"]
    SessionStats.add_tokens(0)
    let after = SessionStats.get_stats()["total_tokens_estimated"]
    _assert_equal(after, before, "zero tokens is no-op")
}

fn test_add_tokens_large() {
    print("\n=== add_tokens large ===")
    SessionStats.add_tokens(1000000)
    let tokens = SessionStats.get_stats()["total_tokens_estimated"]
    _assert(tokens >= 1000000, "handles large token counts")
}

// ── get_elapsed_time ─────────────────────────────────────────

fn test_get_elapsed_time() {
    print("\n=== get_elapsed_time ===")
    SessionStats.init()
    let elapsed = SessionStats.get_elapsed_time()
    _assert(elapsed >= 0, "elapsed time is non-negative")
    _assert(elapsed < 60, "elapsed time < 60s (test ran quickly)")
}

// ── record_snapshot ──────────────────────────────────────────

fn test_record_snapshot() {
    print("\n=== record_snapshot ===")
    SessionStats.record_snapshot(42, 5000, 0.75)
    let stats = SessionStats.get_stats()
    _assert_equal(stats["last_message_count"], 42, "last_message_count = 42")
    _assert_equal(stats["last_total_tokens"], 5000, "last_total_tokens = 5000")
    _assert_equal(stats["last_usage_ratio"], 0.75, "last_usage_ratio = 0.75")
    _assert_equal(stats["last_has_snapshot"], true, "last_has_snapshot = true")
}

fn test_record_snapshot_overwrite() {
    print("\n=== record_snapshot overwrites previous ===")
    SessionStats.record_snapshot(10, 100, 0.1)
    SessionStats.record_snapshot(20, 200, 0.2)
    let stats = SessionStats.get_stats()
    _assert_equal(stats["last_message_count"], 20, "last_message_count overwritten")
    _assert_equal(stats["last_total_tokens"], 200, "last_total_tokens overwritten")
    _assert_equal(stats["last_usage_ratio"], 0.2, "last_usage_ratio overwritten")
}

fn test_record_snapshot_zero() {
    print("\n=== record_snapshot zeros ===")
    SessionStats.record_snapshot(0, 0, 0.0)
    let stats = SessionStats.get_stats()
    _assert_equal(stats["last_message_count"], 0, "zero message count")
    _assert_equal(stats["last_total_tokens"], 0, "zero tokens")
    _assert_equal(stats["last_usage_ratio"], 0.0, "zero usage ratio")
    _assert_equal(stats["last_has_snapshot"], true, "has_snapshot still true")
}

// ── get_stats ────────────────────────────────────────────────

fn test_get_stats_returns_map() {
    print("\n=== get_stats returns map with all fields ===")
    let stats = SessionStats.get_stats()
    _assert(type(stats) == "dict", "get_stats returns a dict")

    // All 9 fields present
    _assert(stats["start_time"] != null, "has start_time")
    _assert(stats["conversation_turns"] != null, "has conversation_turns")
    _assert(stats["agent_calls"] != null, "has agent_calls")
    _assert(stats["total_tokens_estimated"] != null, "has total_tokens_estimated")
    _assert(stats["elapsed_time"] != null, "has elapsed_time")
    _assert(stats["last_message_count"] != null, "has last_message_count")
    _assert(stats["last_total_tokens"] != null, "has last_total_tokens")
    _assert(stats["last_usage_ratio"] != null, "has last_usage_ratio")
    _assert(stats["last_has_snapshot"] != null, "has last_has_snapshot")
}

// ── Run all tests ────────────────────────────────────────────

main {
    print("═══════════════════════════════════════════")
    print("  session_stats.helen 测试")
    print("═══════════════════════════════════════════")

    test_init_sets_start_time()
    test_init_idempotent()
    test_increment_turns()
    test_increment_turns_multiple()
    test_increment_agent_calls()
    test_add_tokens()
    test_add_tokens_zero()
    test_add_tokens_large()
    test_get_elapsed_time()
    test_record_snapshot()
    test_record_snapshot_overwrite()
    test_record_snapshot_zero()
    test_get_stats_returns_map()

    print("\n═══════════════════════════════════════════")
    print("  全部 session_stats 测试完成")
    print("═══════════════════════════════════════════")
}
