import std.core.*
import std.str.*
import std.list.*
import std.dict.*
import std.math.*
import std.debug.*

main {
    import "math" as Math
    let sqrt_fn = Math.sqrt

    agent Worker(reply: Channel) {
        main {
            reply.send({"status": "ok"})
            reply.close()
        }
    }

    let mb = spawn Worker()
    let r = mb.receive()
    print(r["status"])
}
