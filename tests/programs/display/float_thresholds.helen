import std.core.*
import std.math.*

main {
    // Float repr thresholds (Task 13.4): must be byte-identical to Python
    print(1e-20)
    print(1.5e-05)
    print(1e-05)
    print(1e-04)
    print(1e+15)
    print(1e+16)
    print(1e+20)
    print(0.1 + 0.2)
    print(1.0)
    print(0.5)
    print(1 / 3)
    print(2.0 * 3)
    print(123456789.123456789)
    print(pow(2, 10))
    print(pow(2, -3))
    print(round(3.7))
    print(round(3.2))
    print(sqrt(16))
    print(-0.0)
    print(3.14159265358979)
}
