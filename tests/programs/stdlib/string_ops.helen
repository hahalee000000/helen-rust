import std.core.*
import std.str.*

main {
    print(upper("hello"))
    print(lower("HELLO"))
    print(substring("hello world", 0, 5))
    print(split("a,b,c", ","))
    print(join(["a", "b"], "-"))
    print(contains("hello", "ell"))
    print(startswith("hello", "hel"))
    print(endswith("hello", "lo"))
    print(replace("aaa", "a", "b"))
    print(strip("  x  "))
    print(repeat("ab", 3))
    print(reverse("abc"))
    print(count("banana", "an"))
    print(find("hello", "ll"))
    print(find("hello", "zz"))
    print(trim_prefix("hello", "he"))
    print(trim_suffix("hello", "lo"))
    print(pad_left("5", 3, "0"))
    print(pad_right("5", 3, "0"))
    print(center("x", 5, "-"))
    print(format_float(3.14159, 2))
    print(levenshtein("kitten", "sitting"))
    print(similarity("abc", "abc"))
    print(tokenize("hello world foo"))
    print(normalize_whitespace("  a   b  c "))
    print(base64_encode("hello"))
    print(base64_decode("aGVsbG8="))
    print(html_escape("<a href='x'>&"))
    print(regex_test("\\d+", "abc123"))
    print(regex_findall("\\d+", "a1b22c333"))
    print(regex_replace("\\d+", "a1b2", "X"))
    print(regex_split(",", "a,b,c"))
    print(chr(65))
    print(ord("A"))
}
