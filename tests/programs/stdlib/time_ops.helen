import std.core.*
import std.time.*

main {
    print(date(2024, 1, 15))
    print(date_format("2024-01-15", "%Y/%m/%d"))
    print(date_year("2024-01-15"))
    print(date_month("2024-01-15"))
    print(date_day("2024-01-15"))
    print(date_weekday("2024-01-15"))
    print(date_add("2024-01-15", 10))
    print(date_diff("2024-01-15", "2024-01-20"))
    print(date_parse("15/01/2024", "%d/%m/%Y"))
    print(datetime(2024, 1, 15, 10, 30, 0))
}
