import std.core.*
import std.math.*

main {
    print(pow(2, 10))
    print(sqrt(16))
    print(floor(3.7))
    print(ceil(3.2))
    print(round(3.14159, 2))
    print(mean([1, 2, 3, 4]))
    print(median([1, 3, 2]))
    print(mode([1, 1, 2]))
    print(variance([1, 2, 3, 4]))
    print(stddev([1, 2, 3, 4]))
    print(sum([1, 2, 3]))
    print(product([2, 3, 4]))
    print(stats_min([3, 1, 2]))
    print(stats_max([3, 1, 2]))
    print(cos(0))
    print(sin(0))
    print(abs(-5))
    print(bit_and(5, 3))
    print(bit_or(5, 3))
    print(bit_xor(5, 3))
    print(bit_not(5))
    print(bit_shift_left(5, 2))
    print(bit_shift_right(20, 2))
    print(log(1))
    print(exp(0))
}
